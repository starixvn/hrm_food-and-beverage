<Window x:Class="NexFB.WinAppSmartCard.Views.SideFoodPopup"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:helpers="clr-namespace:NexFB.WinAppSmartCard.GlobalResources.Helpers"
        SizeToContent="WidthAndHeight" Topmost="False" ShowInTaskbar="False" WindowStyle="None"
		ResizeMode="NoResize" BorderBrush="Silver" BorderThickness="1" WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<helpers:LocalizationHelper x:Key="localisation"/>
		<Color x:Key="customBlue"  A="255"   R="54" G="95" B="177"  />
		<SolidColorBrush x:Key="customBlueBrush" Color="{StaticResource customBlue}"></SolidColorBrush>
		<SolidColorBrush x:Key="customBlueBrushOpacity" Color="LightGray" Opacity="0.11"></SolidColorBrush>
		<Style x:Key="calcyListbox"  TargetType="ListBox">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBox">
						<Grid >
							<Grid.RowDefinitions>
								<RowDefinition Height="45"></RowDefinition>
								<RowDefinition></RowDefinition>
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Height="55" VerticalAlignment="Center" Background="#E1E1E1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="50"/>
									<ColumnDefinition Width="400"/>
									<ColumnDefinition Width="275"/>
									<ColumnDefinition Width="150"/>
									<ColumnDefinition Width="100"/>
								</Grid.ColumnDefinitions>
								<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="0"></Border>
								<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="1"></Border>
								<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="2"></Border>
								<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="3"></Border>
								<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="4"></Border>
								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.NumberCount]}" FontSize="16" FontFamily="Segoe Ui Dark"
								 Foreground="#014A81" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.SideDishes]}" FontSize="16" FontFamily="Segoe Ui Dark" 
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Quantity]}" FontSize="16" FontFamily="Segoe Ui Dark"  
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="2" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Payment]}" FontSize="16" FontFamily="Segoe Ui Dark"  
								Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="3" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Delete]}" FontSize="16" FontFamily="Segoe Ui Dark" 
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="4" />
							</Grid>
							<Border Margin="0,0,0,0" Grid.Row="1" SnapsToDevicePixels="True"  Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
								<ItemsPresenter />
							</Border>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="noStyleToListboxItem" TargetType="ListBoxItem">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border>
							<ContentPresenter></ContentPresenter>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<StackPanel Height="auto">
		<Grid Background="#66B5D6" Height="40" VerticalAlignment="Top">
			<Label Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.OrderSideDish]}" FontSize="20" FontWeight="Black"
						 HorizontalAlignment="Left" Margin="0" Name="label1" VerticalAlignment="Center" />
		</Grid>

		<Grid  VerticalAlignment="Stretch">
			<Grid HorizontalAlignment="Stretch" Margin="0,0,0,0" Name="grid1" VerticalAlignment="Top" >
				<Grid.RowDefinitions>
					<RowDefinition/>
				</Grid.RowDefinitions>

				<DockPanel Grid.Row="1" VerticalAlignment="Center" Margin="12,0,0,0" Height="60">
					<Label Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.SidedishOrderer]}" 
				FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" />

					<Label Content="{Binding Path=CurrentEmployeeOrder.FullName}" FontWeight="Bold" 
					FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" />

					<Label Content="{Binding Path=CurrentEmployeeOrder.NickName}" ContentStringFormat=" ({0})"
					 FontWeight="Bold" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" />

					<Label Content=" - " FontWeight="Bold" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" />

					<Label Content="{Binding Path=CurrentEmployeeOrder.Code}" ContentStringFormat="#{0} "
					FontWeight="Bold" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
				</DockPanel>
			</Grid>

			<Grid HorizontalAlignment="Left" Margin="12,60,0,0" Name="grid2" VerticalAlignment="Top">
				<StackPanel Orientation="Vertical">
					<Grid MaxHeight="400">
						<ScrollViewer>
							<ListBox BorderThickness="1,0,1,1" Margin="0,0,40,0" Background="{StaticResource customBlueBrushOpacity}" 
						HorizontalContentAlignment="Stretch" ItemsSource="{Binding CurrentListSideFood}" Style="{StaticResource calcyListbox}" ItemContainerStyle="{StaticResource noStyleToListboxItem}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid Height="auto" MinHeight="50" Margin="0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="50"/>
												<ColumnDefinition Width="400"/>
												<ColumnDefinition Width="275"/>
												<ColumnDefinition Width="150"/>
												<ColumnDefinition Width="100"/>
											</Grid.ColumnDefinitions>
											<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="0"></Border>
											<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="1"></Border>
											<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="2"></Border>
											<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="3"></Border>
											<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="4"></Border>

											<TextBlock Text="{Binding Path=CurrentItemNo}" FontSize="20" 
											HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0"/>

											<TextBlock Text="{Binding Path=DisplayFoodName}" FontSize="20" Margin="5,0,5,0" TextWrapping="WrapWithOverflow"
											 HorizontalAlignment="Left" VerticalAlignment="Center" Width="400" Grid.Column="1"/>

											<!--Quantity-->
											<Grid Grid.Column="2">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="80"/>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="80" />
												</Grid.ColumnDefinitions>
												<Button Style="{StaticResource TileButton}" Margin="1"
											Command="{Binding DataContext.SubQuantityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding Path=FoodId}" Grid.Column="0" >
													<Button.Template>
														<ControlTemplate>
															<Border Background="#fff" HorizontalAlignment="Center" VerticalAlignment="Center" Width="80">
																<Image Width="33" Height="30" Source="pack://application:,,,/Images/sub.png" />
															</Border>
														</ControlTemplate>
													</Button.Template>
												</Button>
												<Border HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"
										BorderBrush="Silver" BorderThickness="1" Width="110" Height="40" Margin="2">
													<TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=Quantity}"
											 FontSize="20" HorizontalAlignment="Center"/>
												</Border>

												<Button Style="{StaticResource TileButton}" Margin="1"
											Command="{Binding DataContext.AddQuantityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding Path=FoodId}" Grid.Column="2" >
													<Button.Template>
														<ControlTemplate>
															<Border Background="#fff" HorizontalAlignment="Center" VerticalAlignment="Center" Width="80">
																<Image Width="33" Height="30" Source="pack://application:,,,/Images/plus.png" />
															</Border>
														</ControlTemplate>
													</Button.Template>
												</Button>
											</Grid>

											<!--Price-->
											<TextBlock Text="{Binding Path=DisplayPrice}" FontSize="20" HorizontalAlignment="Right" 
											VerticalAlignment="Center"  Grid.Column="3" Margin="0,0,5,0"/>

											<!--Delete-->
											<Button Style="{StaticResource TileButton}" CommandParameter="{Binding Path=FoodId}" Grid.Column="4" 
												Command="{Binding DataContext.DeletedFoodCommand, RelativeSource={RelativeSource AncestorType=ListBox}}">
												<Button.Template>
													<ControlTemplate>
														<Border Background="#fff" HorizontalAlignment="Center" VerticalAlignment="Center" >
															<Image Width="90" Height="30" Source="pack://application:,,,/Images/remove1.png" />
														</Border>
													</ControlTemplate>
												</Button.Template>
											</Button>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>

						</ScrollViewer>
					</Grid>

					<Grid Height="40" Margin="0,0,40,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="50"/>
							<ColumnDefinition Width="400"/>
							<ColumnDefinition Width="275"/>
							<ColumnDefinition Width="150"/>
							<ColumnDefinition Width="100"/>
						</Grid.ColumnDefinitions>
						<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="0"></Border>
						<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="1"></Border>
						<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="2"></Border>
						<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="3"></Border>
						<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="4"></Border>
						<Label HorizontalAlignment="Right" Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Total]}" 
						FontWeight="Black" Grid.ColumnSpan="2" FontSize="20"/>
						<!--Total order-->
						<Label Grid.Column="2" HorizontalAlignment="Right"  Margin="0,0,5,0"
						Content="{Binding TotalOrder}" FontWeight="Black"  FontSize="20"/>
						<!--Total price-->
						<Label Grid.Column="3" HorizontalAlignment="Right" Foreground="Red" Margin="0,0,5,0"
						Content="{Binding TotalPayment}"  FontWeight="Black"  FontSize="20"/>
					</Grid>

					<Grid VerticalAlignment="Bottom" Margin="0,20,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Button Background="#66B5D6" Foreground="White" Command="{Binding Path=ConfirmSideFoodPopup}"
						CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
					Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Submit]}" Height="65" Style="{StaticResource TileButton}"
					HorizontalAlignment="Right" Margin="0,0,50,0" Name="button1" VerticalAlignment="Top" Width="150" FontSize="22"/>

						<Button Background="#EF4339" Foreground="White"
					Grid.Column="1" Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Cancel]}" Height="65" Style="{StaticResource TileButton}"
					HorizontalAlignment="Left" VerticalAlignment="Top" Width="150" Margin="50,0,0,0" 
					Command="{Binding Path=CloseSideFoodPopup}" FontSize="22" 
					CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"/>
					</Grid>
				</StackPanel>
			</Grid>
		</Grid>

	</StackPanel>

</Window>


