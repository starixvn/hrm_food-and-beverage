<UserControl x:Class="NexFB.WinAppSmartCard.Views.CombineDish"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:helpers="clr-namespace:NexFB.WinAppSmartCard.GlobalResources.Helpers"
			  xmlns:converter="clr-namespace:NexFB.WinAppSmartCard.Converter"
			  	xmlns:local="clr-namespace:NexFB.WinAppSmartCard.Converter"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
	<UserControl.Resources>
		<converter:StringConverter x:Key="stringConverter" />
		<helpers:LocalizationHelper x:Key="localisation"/>
		<Color x:Key="customBlue"  A="255"   R="54" G="95" B="177"  />
		<SolidColorBrush x:Key="customBlueBrush" Color="{StaticResource customBlue}"></SolidColorBrush>
		<SolidColorBrush x:Key="customBlueBrushOpacity" Color="#fff" Opacity="0.11"></SolidColorBrush>
		<Style x:Key="OrderListBox"  TargetType="ListBox">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBox">
						<Grid >
							<Grid.RowDefinitions>
								<RowDefinition Height="50"></RowDefinition>
								<RowDefinition></RowDefinition>
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Height="50" VerticalAlignment="Center" Background="#E1E1E1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="85"/>
									<ColumnDefinition Width="220"/>
									<ColumnDefinition Width="430"/>
									<ColumnDefinition Width="180"/>
									<ColumnDefinition Width="120"/>
									<ColumnDefinition Width="120"/>
								</Grid.ColumnDefinitions>
								<Border BorderThickness="1" BorderBrush="#999999" Grid.Column="0"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="1"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="2"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="3"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="4"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="5"></Border>
								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.NumberCount]}"
								 FontSize="20" FontFamily="Segoe Ui Dark"
								 Foreground="#014A81" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Member]}"
								 FontSize="20" FontFamily="Segoe Ui Dark" 
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Menu]}"
								FontSize="20" FontFamily="Segoe Ui Dark"  
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="2" />

								<TextBlock
								Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Payment]}" FontSize="20" FontFamily="Segoe Ui Dark"  
								Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="3" />

								<TextBlock
								Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.SideDishes]}" FontSize="20" FontFamily="Segoe Ui Dark"  
								Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="4" />

								<TextBlock
								Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Delete]}" FontSize="20" FontFamily="Segoe Ui Dark"  
								Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="5" />

							</Grid>
							<Border Margin="0,0,0,0" Grid.Row="1" SnapsToDevicePixels="True"  Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
								<ItemsPresenter />
							</Border>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="MainDishListBox"  TargetType="ListBox">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBox">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="50"></RowDefinition>
								<RowDefinition></RowDefinition>
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Height="50" VerticalAlignment="Center" Background="#E1E1E1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="85"/>
									<ColumnDefinition Width="430"/>
									<ColumnDefinition Width="650"/>
								</Grid.ColumnDefinitions>
								<Border BorderThickness="1" BorderBrush="#999999" Grid.Column="0"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="1"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="2"></Border>
								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.NumberCount]}"
								 FontSize="20" FontFamily="Segoe Ui Dark"
								 Foreground="#014A81" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Member]}"
								 FontSize="20" FontFamily="Segoe Ui Dark" 
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Menu]}"
								FontSize="20" FontFamily="Segoe Ui Dark"  
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="2" />

							</Grid>
							<Border Margin="0,0,0,0" Grid.Row="1" SnapsToDevicePixels="True"  Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
								<ItemsPresenter />
							</Border>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SideDishListBox"  TargetType="ListBox">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBox">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="50"></RowDefinition>
								<RowDefinition></RowDefinition>
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Height="50" VerticalAlignment="Center" Background="#E1E1E1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="85"/>
									<ColumnDefinition Width="220"/>
									<ColumnDefinition Width="430"/>
									<ColumnDefinition Width="180"/>
									<ColumnDefinition Width="250"/>
								</Grid.ColumnDefinitions>
								<Border BorderThickness="1" BorderBrush="#999999" Grid.Column="0"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="1"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="2"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="3"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="4"></Border>

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.NumberCount]}"
								 FontSize="20" FontFamily="Segoe Ui Dark"
								 Foreground="#014A81" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Member]}"
								 FontSize="20" FontFamily="Segoe Ui Dark" 
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Menu]}"
								FontSize="20" FontFamily="Segoe Ui Dark"  
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="2" />

								<TextBlock
								Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Quantity]}" FontSize="20" FontFamily="Segoe Ui Dark"  
								Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="3" />

								<TextBlock
								Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Payment]}" FontSize="20" FontFamily="Segoe Ui Dark"  
								Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="4" />

							</Grid>
							<Border Margin="0,0,0,0" Grid.Row="1" SnapsToDevicePixels="True"  Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
								<ItemsPresenter />
							</Border>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="noStyleToListboxItem" TargetType="ListBoxItem">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border>
							<ContentPresenter></ContentPresenter>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>
	<Grid>
		<Grid>
			<Grid.Background>
				<ImageBrush ImageSource="pack://application:,,,/Images/bg.jpg"/>
			</Grid.Background>
		</Grid>

		<!--Screen Order-->
		<Grid Margin="12,0,0,0" Visibility="{Binding Path=ScreenOrderVisible}">
			<Grid.RowDefinitions>
				<RowDefinition Height="60"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<Grid HorizontalAlignment="Left" VerticalAlignment="Stretch" Grid.Row="0" Margin="12,0,0,0">
				<Grid Grid.Row="0">
					<Rectangle Width="550" HorizontalAlignment="Left" Panel.ZIndex="-1" Fill="#000" Opacity=".4" Margin="0,10,0,0" />
					<StackPanel Orientation="Horizontal" Margin="0,3,0,0">
						<Label Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.TicketCreator]}"
						 HorizontalAlignment="Left" Margin="15,10,5,0" VerticalAlignment="Top" FontSize="22" Foreground="#fff"/>
						<Label Content="{Binding Path=OrderOwner.DisplayOrderNickname}" Foreground="#2c98e0" FontWeight="Black"
						 HorizontalAlignment="Left" Margin="-8,10,0,0"  VerticalAlignment="Top" FontSize="22"/>
					</StackPanel>

				</Grid>
			</Grid>

			<Grid Grid.Row="1" Margin="0,10,0,0">
				<Grid HorizontalAlignment="Left" Margin="12,0,0,0" Grid.Row="1" Name="grid2" VerticalAlignment="Top">
					<StackPanel Orientation="Vertical">
						<Grid MaxHeight="350" Background="#fff">
							<ScrollViewer>
								<ListBox BorderThickness="1,0,1,1" Background="{StaticResource customBlueBrushOpacity}" HorizontalContentAlignment="Stretch"
							 ItemsSource="{Binding ObservableListEmployee}" Style="{StaticResource OrderListBox}" ItemContainerStyle="{StaticResource noStyleToListboxItem}"
							 x:Name="ContentListBox">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<Grid Height="auto" MinHeight="50" Margin="0">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="85"/>
													<ColumnDefinition Width="220"/>
													<ColumnDefinition Width="430"/>
													<ColumnDefinition Width="180"/>
													<ColumnDefinition Width="120"/>
													<ColumnDefinition Width="120"/>
												</Grid.ColumnDefinitions>
												<Border BorderThickness="1,0,1,1" BorderBrush="#999999" Grid.Column="0"></Border>
												<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="1"></Border>
												<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="2"></Border>
												<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="3"></Border>
												<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="4"></Border>
												<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="5"></Border>

												<TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=OrderNo}" FontSize="20" HorizontalAlignment="Center" Grid.Column="0"/>
												<TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=NickName}" FontSize="20" HorizontalAlignment="Left" Grid.Column="1"/>
												<TextBlock Margin="5,0,5,0" VerticalAlignment="Center" TextWrapping="WrapWithOverflow" Width="320"
														local:TextBlockCustom.FormattedText="{Binding Path=DisplayGeneralOrderInfo, Mode=OneWay, Converter={StaticResource stringConverter}}" 
														FontSize="20" HorizontalAlignment="Left" Grid.Column="2"/>

												<!--total payment-->
												<TextBlock Margin="5,0,10,0" VerticalAlignment="Center" Text="{Binding Path=DisplayTotalPayment}" 
												FontSize="20" HorizontalAlignment="Right" Grid.Column="3"/>

												<Button Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Add]}" FontSize="22"
													Style="{StaticResource TileButton}" CommandParameter="{Binding Path=SysId}" Grid.Column="4"
													Command="{Binding DataContext.AddSideFoodPopup, RelativeSource={RelativeSource AncestorType=ListBox}}" 
													Background="#6CB23E" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2" Foreground="#fff"/>

												<Button Visibility="{Binding DataContext.DeleteButtonVisible, RelativeSource={RelativeSource AncestorType=ListBox}}"
												 Style="{StaticResource TileButton}" CommandParameter="{Binding Path=SysId}" Grid.Column="5" 
												Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}">
													<Button.Template>
														<ControlTemplate>
															<Border Background="#fff" HorizontalAlignment="Center" VerticalAlignment="Center" >
																<Image Width="34" Height="30" Source="pack://application:,,,/Images/remove1.png" />
															</Border>
														</ControlTemplate>
													</Button.Template>
												</Button>
											</Grid>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</ScrollViewer>
						</Grid>

						<!--Take away option-->
						<Grid Background="#fff" Height="50" Margin="1,0,1,0">
							<ToggleButton Foreground="#014A81" FontSize="20" IsEnabled="{Binding Path=CanTakeAway}" 
								 IsChecked="{Binding Path=TakeAwayChecked}"
								Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.TakeAway]}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="{x:Type ToggleButton}">
										<StackPanel Orientation="Horizontal">
											<ContentPresenter Content="{TemplateBinding Content}" Margin="15,0,10,0" VerticalAlignment="Center"/>
											<Image Width="26" Height="26">
												<Image.Style>
													<Style>
														<Setter Property="Image.Source" Value="pack://application:,,,/Images/checkbox-unchecked.png" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True">
																<Setter Property="Image.Source" Value="pack://application:,,,/Images/checkbox-checked.png" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Image.Style>
											</Image>
										</StackPanel>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>
						</Grid>

						<!--Action button-->
						<Grid VerticalAlignment="Bottom" Margin="0,30,0,10">
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
								<Button Background="#66B5D6" Foreground="White" Command="{Binding Path=SaveOrderFood}" Margin="0,0,50,0"
									Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Confirm]}" Height="70" Style="{StaticResource TileButton}"
									HorizontalAlignment="Right" Name="button1" VerticalAlignment="Top" Width="150" FontSize="22"/>

								<Button Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
									Background="#EF4339" Foreground="White" Margin="50,0,0,0"
									Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Cancel]}" Height="70" Style="{StaticResource TileButton}"
									HorizontalAlignment="Left" VerticalAlignment="Top" Width="150" FontSize="22"/>
							</StackPanel>

						</Grid>
					</StackPanel>
				</Grid>
			</Grid>

		</Grid>


		<!--Screen Notification-->
		
	</Grid>
</UserControl>
