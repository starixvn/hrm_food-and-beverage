<UserControl x:Class="NexFB.WinAppSmartCard.Views.SideDishes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:helpers="clr-namespace:NexFB.WinAppSmartCard.GlobalResources.Helpers"
			 xmlns:converter="clr-namespace:NexFB.WinAppSmartCard.Converter"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Width="1280" Height="1024">

	<UserControl.Resources>
		<converter:MoneyConverter x:Key="moneyConverter" />
		<helpers:LocalizationHelper x:Key="localisation"/>
		<Color x:Key="customBlue"  A="255"   R="54" G="95" B="177"  />
		<SolidColorBrush x:Key="customBlueBrush" Color="{StaticResource customBlue}"></SolidColorBrush>
		<SolidColorBrush x:Key="customBlueBrushOpacity" Color="LightGray" Opacity="0.11"></SolidColorBrush>
		<Style x:Key="OrderListBox"  TargetType="ListBox">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBox">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="50"></RowDefinition>
								<RowDefinition></RowDefinition>
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Height="50" VerticalAlignment="Center" Background="#E1E1E1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="500"/>
									<ColumnDefinition Width="220"/>
									<ColumnDefinition Width="170"/>
									<ColumnDefinition Width="150"/>
								</Grid.ColumnDefinitions>
								<Border BorderThickness="1" BorderBrush="#999999" Grid.Column="0"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="1"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="2"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="3"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="4"></Border>
								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.NumberCount]}"
								 FontSize="20" FontFamily="Segoe Ui Dark"
								 Foreground="#014A81" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Dishes]}"
								 FontSize="20" FontFamily="Segoe Ui Dark" 
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Quantity]}"
								FontSize="20" FontFamily="Segoe Ui Dark"  
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="2" />

								<TextBlock
								Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Payment]}" FontSize="20" FontFamily="Segoe Ui Dark"  
								Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="3" />

								<TextBlock
								Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Delete]}" FontSize="20" FontFamily="Segoe Ui Dark"  
								Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="4" />
							</Grid>
							<Border Margin="0,0,0,0" Grid.Row="1" SnapsToDevicePixels="True"  Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
								<ItemsPresenter />
							</Border>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="NotificationListBox"  TargetType="ListBox">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBox">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="50"></RowDefinition>
								<RowDefinition></RowDefinition>
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Height="50" VerticalAlignment="Center" Background="#E1E1E1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="500"/>
									<ColumnDefinition Width="220"/>
									<ColumnDefinition Width="170"/>
								</Grid.ColumnDefinitions>
								<Border BorderThickness="1" BorderBrush="#999999" Grid.Column="0"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="1"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="2"></Border>
								<Border BorderThickness="0,1,1,1" BorderBrush="#999999" Grid.Column="3"></Border>
								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.NumberCount]}"
								 FontSize="20" FontFamily="Segoe Ui Dark"
								 Foreground="#014A81" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Dishes]}"
								 FontSize="20" FontFamily="Segoe Ui Dark" 
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />

								<TextBlock Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Quantity]}"
								FontSize="20" FontFamily="Segoe Ui Dark"  
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="2" />

								<TextBlock
								Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Payment]}" FontSize="20" FontFamily="Segoe Ui Dark"  
								Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="3" />
							</Grid>
							<Border Margin="0,0,0,0" Grid.Row="1" SnapsToDevicePixels="True"  Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
								<ItemsPresenter />
							</Border>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="noStyleToListboxItem" TargetType="ListBoxItem">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border>
							<ContentPresenter></ContentPresenter>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid>
		<Grid>
			<Grid.Background>
				<ImageBrush ImageSource="pack://application:,,,/Images/bg.jpg"/>
			</Grid.Background>
		</Grid>

		<!--View Order-->
		<Grid Margin="24,0,0,0" Visibility="{Binding Path=ScreenOrderVisible}">
			<Grid.RowDefinitions>
				<RowDefinition Height="65"/>
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid Width="1220" Grid.Row="0">
				<Rectangle Width="550" HorizontalAlignment="Left" Panel.ZIndex="-1" Fill="#000" Opacity=".4" Margin="-5,10,0,0" />
				<DockPanel  VerticalAlignment="Bottom" Height="45" Width="1115" HorizontalAlignment="Left" Margin="0,0,0,5">
					<Label Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.TicketCreator]}" 
					FontSize="22" VerticalAlignment="Bottom" Margin="0" Foreground="#fff"/>
					<Label Content="{Binding Path=OrderOwner.NickName}" FontSize="22" VerticalAlignment="Bottom" 
					Foreground="#2c98e0" FontWeight="Black" Margin="0"/>

					<Button Command="{Binding Path=AddFoodCommand}" IsEnabled="{Binding Path=AddFoodEnable}"
						Background="#6CB23E" Style="{StaticResource TileButton}" MinWidth="120"  Margin="0" HorizontalAlignment="Right">
						<Label Foreground="#fff" FontSize="20" FontWeight="Black" Margin="7,0,7,0"
					 Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.AddFood]}" />
					</Button>
				</DockPanel>
			</Grid>

			<Grid HorizontalAlignment="Left" Margin="12,10,0,0" Grid.Row="1" Name="grid2" VerticalAlignment="Top">
				<StackPanel Orientation="Vertical">
					<Grid MaxHeight="350" Background="#fff">
						<ScrollViewer>
							<ListBox BorderThickness="1,0,1,1" Margin="0" Background="{StaticResource customBlueBrushOpacity}" HorizontalContentAlignment="Stretch"
							 ItemsSource="{Binding ObservableSideOrder}" Style="{StaticResource OrderListBox}" ItemContainerStyle="{StaticResource noStyleToListboxItem}"
							 x:Name="ContentListBox">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid Height="50" Margin="0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="80"/>
												<ColumnDefinition Width="500"/>
												<ColumnDefinition Width="220"/>
												<ColumnDefinition Width="170"/>
												<ColumnDefinition Width="150"/>
											</Grid.ColumnDefinitions>
											<Border BorderThickness="1,0,1,1" BorderBrush="#999999" Grid.Column="0"></Border>
											<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="1"></Border>
											<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="2"></Border>
											<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="3"></Border>
											<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="4"></Border>
											<TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=OrderNo}" FontSize="20" HorizontalAlignment="Center" Grid.Column="0"/>
											<ComboBox x:Name="MenuList"  Grid.Column="1"  ItemsSource="{Binding ListSideFood, Mode=TwoWay}"
											 DisplayMemberPath="DisplayFoodName" 
											 SelectedValuePath="FoodId"
											 SelectedValue="{Binding Path=SelectedValueDropDown, Mode=TwoWay}"
											 SelectedItem="{Binding DataContext.SelectedFood, RelativeSource={RelativeSource AncestorType=ListBox}}"
											 Style="{StaticResource ComboBoxFlatStyle}" FontSize="20"
											 Height="44" VerticalAlignment="Center" Width="490" BorderBrush="Silver" BorderThickness="1">
												<ComboBox.ItemContainerStyle>
													<Style TargetType="ComboBoxItem">
														<Setter Property="Padding" Value="7"/>
													</Style>
												</ComboBox.ItemContainerStyle>
											</ComboBox>
											<!--Quantity-->

											<Grid Grid.Column="2">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="40"/>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="40" />
												</Grid.ColumnDefinitions>
												<Button Style="{StaticResource TileButton}"
											Command="{Binding DataContext.SubQuantityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding Path=OrderNo}" Grid.Column="0" >
													<Button.Template>
														<ControlTemplate>
															<Border Background="#fff" HorizontalAlignment="Center" VerticalAlignment="Center" >
																<Image Width="33" Height="30" Source="pack://application:,,,/Images/sub.png" />
															</Border>
														</ControlTemplate>
													</Button.Template>
												</Button>
												<Border HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"
										BorderBrush="Silver" BorderThickness="1" Width="110" Height="40">
													<TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=Quantity}"
											 FontSize="20" HorizontalAlignment="Center"/>
												</Border>

												<Button Style="{StaticResource TileButton}"
											Command="{Binding DataContext.AddQuantityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding Path=OrderNo}" Grid.Column="2" >
													<Button.Template>
														<ControlTemplate>
															<Border Background="#fff" HorizontalAlignment="Center" VerticalAlignment="Center" >
																<Image Width="33" Height="30" Source="pack://application:,,,/Images/plus.png" />
															</Border>
														</ControlTemplate>
													</Button.Template>
												</Button>
											</Grid>


											<!--Payment-->
											<TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Text="{Binding Path=ChangedPrice, Converter={StaticResource moneyConverter}}" FontSize="20" HorizontalAlignment="Right" Grid.Column="3"/>
											<Button Style="{StaticResource TileButton}"
											Command="{Binding DataContext.DeletedFoodCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding Path=OrderNo}" Grid.Column="4" >
												<Button.Template>
													<ControlTemplate>
														<Border Background="#fff" HorizontalAlignment="Center" VerticalAlignment="Center" >
															<Image Width="34" Height="30" Source="pack://application:,,,/Images/remove1.png" />
														</Border>
													</ControlTemplate>
												</Button.Template>
											</Button>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</ScrollViewer>
					</Grid>

					<!--Row total-->
					<Grid Height="50" Background="#fff">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="80"/>
							<ColumnDefinition Width="500"/>
							<ColumnDefinition Width="220"/>
							<ColumnDefinition Width="170"/>
							<ColumnDefinition Width="150"/>
						</Grid.ColumnDefinitions>
						<Border BorderThickness="1,0,0,1" BorderBrush="#999999" Grid.Column="0"></Border>
						<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="1"></Border>
						<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="2"></Border>
						<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="3"></Border>
						<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="4"></Border>
						<TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Total]}" 
						FontWeight="Black" FontSize="20" HorizontalAlignment="Right" Grid.Column="1"/>
						<TextBlock Margin="0,0,5,0" VerticalAlignment="Center" FontWeight="Black" Foreground="#c72413"
					Text="{Binding Path=TotalPrice, Converter={StaticResource moneyConverter}}" FontSize="20" HorizontalAlignment="Right" Grid.Column="3"/>
						<TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=TotalItem}" FontWeight="Black"
					FontSize="20" HorizontalAlignment="Center" Grid.Column="2"/>
					</Grid>

					<!--Take Away options-->
					<Grid Background="#fff" Height="50" Margin="1,0,1,0">
						<ToggleButton Foreground="#014A81" FontSize="20" x:Name="TakeAwayOptions" IsChecked="{Binding Path=TakeAwayChecked}"
							Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.TakeAway]}">
							<ToggleButton.Template>
								<ControlTemplate TargetType="{x:Type ToggleButton}">
									<StackPanel Orientation="Horizontal">
										<ContentPresenter Content="{TemplateBinding Content}"
											Margin="15,0,10,0" VerticalAlignment="Center"/>
										<Image Width="26" Height="26">
											<Image.Style>
												<Style>
													<Setter Property="Image.Source" Value="pack://application:,,,/Images/checkbox-unchecked.png" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True">
															<Setter Property="Image.Source" Value="pack://application:,,,/Images/checkbox-checked.png" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Image.Style>
										</Image>
									</StackPanel>
								</ControlTemplate>
							</ToggleButton.Template>
						</ToggleButton>
					</Grid>

					<!--Action Button-->
					<Grid VerticalAlignment="Bottom" Margin="0,30,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Button Background="#66B5D6" Foreground="White" Command="{Binding Path=SaveDataCommand}" Margin="0,0,15,0"
						CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
					Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Confirm]}" Height="50" Style="{StaticResource TileButton}"
					HorizontalAlignment="Right" Name="button1" VerticalAlignment="Top" Width="108" />

						<Button Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
							Background="#EF4339" Foreground="White" Grid.Column="1" Margin="15,0,0,0"
						CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
					Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Cancel]}" Height="50" Style="{StaticResource TileButton}"
					HorizontalAlignment="Left" VerticalAlignment="Top" Width="108" />
					</Grid>
				</StackPanel>
			</Grid>
		</Grid>


		<!--View Notification-->
		<Grid Visibility="{Binding Path=ScreenNotificationVisible}" Margin="24,0,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="110"/>
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid Width="1220" HorizontalAlignment="Center" VerticalAlignment="Stretch" Grid.Row="0">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Rectangle Width="550" HorizontalAlignment="Left" Panel.ZIndex="-1" Fill="#000" Opacity=".4" Margin="-5,10,0,0" />
				<Rectangle Width="550" HorizontalAlignment="Left" Grid.Row="1" Panel.ZIndex="-1" Fill="#000" Opacity=".4" Margin="-5,0,0,0" />
				<DockPanel  Grid.Row="0" Margin="100,10,0,0">
					<Label Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.TicketLabel]}" 
					FontSize="22" VerticalAlignment="Center" Foreground="#fff" Margin="0,8,0,0"/>
					<Label Content="{Binding Path=OrderNo}" FontSize="25" VerticalAlignment="Center"
					 Foreground="#fff" FontWeight="Black" Margin="-8,6,0,0"/>
				</DockPanel>
				<DockPanel  Grid.Row="1" Margin="100,0,0,0">
					<Label Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.TicketCreator]}" 
					FontSize="22" VerticalAlignment="Center" Foreground="#fff" Margin="0,0,0,6"/>
					<Label Content="{Binding Path=OrderOwner.NickName}" FontSize="22" VerticalAlignment="Center"
					 Foreground="#2c98e0" FontWeight="Black" Margin="-8,0,0,6"/>
				</DockPanel>

				<Grid HorizontalAlignment="Left" VerticalAlignment="Center" Grid.RowSpan="2" Width="100">
					<Border HorizontalAlignment="Center" VerticalAlignment="Center"  >
						<TextBlock Text="{Binding Path=OrderNo}" FontSize="65" Margin="0,10,0,0" Foreground="#fff"
							 HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
					</Border>
				</Grid>

			</Grid>

			<Grid HorizontalAlignment="Left" Margin="12,10,0,0" Grid.Row="1" VerticalAlignment="Top">
				<StackPanel Orientation="Vertical">
					<Grid MaxHeight="350" Background="#fff">
						<ScrollViewer>
							<ListBox BorderThickness="1,0,1,1" Margin="0" Background="{StaticResource customBlueBrushOpacity}" HorizontalContentAlignment="Stretch"
							 ItemsSource="{Binding ObservableSideOrder}" Style="{StaticResource NotificationListBox}" ItemContainerStyle="{StaticResource noStyleToListboxItem}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid Height="50" Margin="0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="80"/>
												<ColumnDefinition Width="500"/>
												<ColumnDefinition Width="220"/>
												<ColumnDefinition Width="170"/>
											</Grid.ColumnDefinitions>
											<Border BorderThickness="1,0,1,1" BorderBrush="#999999" Grid.Column="0"></Border>
											<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="1"></Border>
											<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="2"></Border>
											<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="3"></Border>
											<TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=OrderNo}" FontSize="20" HorizontalAlignment="Center" Grid.Column="0"/>

											<!--Food name-->
											<TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=SelectedFoodName}" FontSize="20" HorizontalAlignment="Left" Grid.Column="1"/>

											<!--Quantity-->
											<TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=Quantity}" FontSize="20" HorizontalAlignment="Center" Grid.Column="2"/>

											<!--Payment-->
											<TextBlock Margin="0,0,50,0" VerticalAlignment="Center" Text="{Binding Path=ChangedPrice, Converter={StaticResource moneyConverter}}" FontSize="20" HorizontalAlignment="Right" Grid.Column="3"/>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</ScrollViewer>
					</Grid>

					<!--Row total-->
					<Grid Height="50" Background="#fff">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="80"/>
							<ColumnDefinition Width="500"/>
							<ColumnDefinition Width="220"/>
							<ColumnDefinition Width="170"/>
						</Grid.ColumnDefinitions>
						<Border BorderThickness="1,0,0,1" BorderBrush="#999999" Grid.Column="0"></Border>
						<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="1"></Border>
						<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="2"></Border>
						<Border BorderThickness="0,0,1,1" BorderBrush="#999999" Grid.Column="3"></Border>
						<TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Total]}" 
						FontWeight="Black" FontSize="20" HorizontalAlignment="Right" Grid.Column="1"/>
						<TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=TotalItem}" FontWeight="Black"
					FontSize="20" HorizontalAlignment="Center" Grid.Column="2"/>
						<TextBlock Margin="0,0,50,0" VerticalAlignment="Center" FontWeight="Black" Foreground="#c72413"
					Text="{Binding Path=TotalPrice, Converter={StaticResource moneyConverter}}" FontSize="20" HorizontalAlignment="Right" Grid.Column="3"/>
					</Grid>

					<!--Take away options-->
					<Grid Background="#fff" Height="50" Margin="1,0,1,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="400"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<ToggleButton Foreground="#014A81" FontSize="20" Grid.Column="0"
						IsEnabled="False" x:Name="TakeAwayOptionsReadOnly" IsChecked="{Binding Path=TakeAwayChecked}"
						Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.TakeAway]}">
							<ToggleButton.Template>
								<ControlTemplate TargetType="{x:Type ToggleButton}">
									<StackPanel Orientation="Horizontal">
										<ContentPresenter Content="{TemplateBinding Content}" Margin="15,0,10,0" VerticalAlignment="Center"/>
										<Image Width="26" Height="26">
											<Image.Style>
												<Style>
													<Setter Property="Image.Source" Value="pack://application:,,,/Images/checkbox-unchecked.png" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True">
															<Setter Property="Image.Source" Value="pack://application:,,,/Images/checkbox-checked.png" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Image.Style>
										</Image>
									</StackPanel>
								</ControlTemplate>
							</ToggleButton.Template>
						</ToggleButton>

						<Grid Grid.Column="1">
							<TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Foreground="#4DB54B"
						Text="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Message_OrderSuccessful]}" />
						</Grid>

					</Grid>

					<!--Action button-->
					<Grid VerticalAlignment="Bottom" Margin="0,30,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
							<Button Command="{Binding DataContext.ReturnStandByScreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
								Background="#66B5D6" Foreground="White" Margin="0,0,5,0"
						CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
					 Height="50" Style="{StaticResource TileButton}"
					HorizontalAlignment="Center" VerticalAlignment="Top" Width="108">
								<StackPanel Orientation="Horizontal">
									<Label Content="{Binding Source={StaticResource localisation}, Path=[MainScreenResources.Exit]}" Foreground="#fff" FontSize="20"/>
									<Label ContentStringFormat="({0})" Content="{Binding Path=CountDownTimer}" Margin="-4,0,0,0" Foreground="#fff" FontSize="20"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Grid>
		</Grid>

	</Grid>

</UserControl>
