<Window x:Class="NexFB.WinApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:l="clr-namespace:NexFB.WinApp.DependencyProperties"
		xmlns:local="clr-namespace:NexFB.WinApp.ViewModels"
		xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
        Title="Order Foods" Width="1280" Height="1024" WindowState="Maximized"
		ResizeMode="NoResize"
		l:ControlBox.HasMinimizeButton="False"
		l:ControlBox.HasMaximizeButton="False">
	<Window.Resources>
		<!--AllowsTransparency="False"-->
		<!--WindowStyle="None"-->
	</Window.Resources>

	<Window.DataContext>
		<local:MainViewModel/>
	</Window.DataContext>
	<Grid Background="Black">
		<Grid.RowDefinitions>
			<RowDefinition Height="65"/>
			<RowDefinition Height="920*"/>
		</Grid.RowDefinitions>

		<Button Style="{StaticResource TileButton}" Content="{x:Static resx:WinFormMainResource.Receive}" Command="{Binding ViewPedingFoodCommand}" Foreground="White" Background ="#3A95FC" Height="42" HorizontalAlignment="Left" Name="button1" VerticalAlignment="Top" Width="122" Margin="12,12,0,0" />
		<Button Style="{StaticResource TileButton}" Content="{x:Static resx:WinFormMainResource.Exported}" Command="{Binding ViewDeliveredFoodCommand}" Foreground="White" Background="#FA5934" Height="42" HorizontalAlignment="Left" Name="button2" VerticalAlignment="Top" Width="122" Margin="140,12,0,0" />
		<Button Style="{StaticResource TileButton}" Content="{x:Static resx:WinFormMainResource.Order}" Height="42" Foreground="White" Background="#47BF43" HorizontalAlignment="Left" Name="button3" VerticalAlignment="Top" Width="122" Margin="268,12,0,0" />
		<Button Style="{StaticResource TileButton}" Content="{x:Static resx:WinFormMainResource.Statistic}" Height="42" Foreground="White" Background="#3A95FC" HorizontalAlignment="Left" Name="button4" VerticalAlignment="Top" Width="122" Margin="396,12,0,0" />
		<Button Style="{StaticResource TileButton}" Command="{Binding CloseWindow}" CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
		x:Name="closeWindow" Foreground="White" Background="Red" HorizontalAlignment="Right" 
		VerticalAlignment="Top" Height="40">
			<Button.Template>
				<ControlTemplate>
					<Border HorizontalAlignment="Center" VerticalAlignment="Center" >
						<Image Source="pack://application:,,,/Images/window_close.png" />
					</Border>
				</ControlTemplate>
			</Button.Template>
		</Button>

		<ContentControl Content="{Binding CurrentViewModel}" BorderBrush="Red" Grid.Row="1" Background="#3A95FC" />
	</Grid>


</Window>
