<Window x:Class="NexFB.WinApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:l="clr-namespace:NexFB.WinApp.DependencyProperties"
		xmlns:local="clr-namespace:NexFB.WinApp.ViewModels"
        Title="Order Foods" Width="1280" Height="1024" WindowState="Maximized"
		l:ControlBox.HasMinimizeButton="False"
		l:ControlBox.HasMaximizeButton="False">
	<Window.Resources>
		<Style x:Key="RoundButtonTemplate" TargetType="Button">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Name="border" CornerRadius="0" Background="{TemplateBinding Background}" BorderThickness="1">
							<ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center">
							</ContentPresenter>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="Button.IsDefaulted" Value="True">
								<Setter Property="BorderBrush" TargetName="border" Value="Red"/>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" TargetName="border" Value="#FFBEE6FD"/>
								<Setter Property="BorderBrush" TargetName="border" Value="#FF3C7FB1"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Background" TargetName="border" Value="#FFC4E5F6"/>
								<Setter Property="BorderBrush" TargetName="border" Value="#FF2C628B"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Background" TargetName="border" Value="#FFF4F4F4"/>
								<Setter Property="BorderBrush" TargetName="border" Value="#FFADB2B5"/>
								<Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="#FF838383"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Window.DataContext>
		<local:MainViewModel/>
	</Window.DataContext>
	<Grid Background="Black">
		<Grid.RowDefinitions>
			<RowDefinition Height="20" />
			<RowDefinition Height="923*" />
		</Grid.RowDefinitions>

		<Button Style="{StaticResource RoundButtonTemplate}" Content="Đang Chờ" Command="{Binding ViewPedingFoodCommand}" FontSize="15" Foreground="White" Background ="#3A95FC" Height="42" HorizontalAlignment="Left" Name="button1" VerticalAlignment="Top" Width="122" Margin="32,12,0,0" Grid.RowSpan="3" />
		<Button Style="{StaticResource RoundButtonTemplate}" Content="Đã Xuất" Command="{Binding ViewDeliveredFoodCommand}" FontSize="15" Foreground="White" Background="#FA5934" Height="42" HorizontalAlignment="Left" Name="button2" VerticalAlignment="Top" Width="122" Margin="187,12,0,0" Grid.RowSpan="2" />
		<Button Style="{StaticResource RoundButtonTemplate}" Content="Gọi Món" Height="42" FontSize="15" Foreground="White" Background="#47BF43" HorizontalAlignment="Left" Name="button3" VerticalAlignment="Top" Width="122" Margin="342,12,0,0" Grid.RowSpan="2" />
		<Button Style="{StaticResource RoundButtonTemplate}" Content="Thống kê" Height="42" FontSize="15" Foreground="White" Background="#3A95FC" HorizontalAlignment="Left" Name="button4" VerticalAlignment="Top" Width="122" Margin="497,12,0,0" Grid.RowSpan="2" />
		<ContentControl Content="{Binding CurrentViewModel}" Margin="-12,40,12,0" Grid.Row="2" />

	</Grid>
</Window>
