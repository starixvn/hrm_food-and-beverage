<UserControl 
	x:Class="NexFB.WinApp.Views.ManageOrder.OrderFood"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d" 
	xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
	d:DesignHeight="1024" d:DesignWidth="1280">
	<UserControl.Resources>
		<!--<Style x:Key="buttonKeypad" TargetType="Button" >
			<Setter Property="FontSize" Value="38"/>
			<Setter Property="Background" Value="#e2e2e2"/>
		</Style>-->
	</UserControl.Resources>

	<Grid>
		<Grid Background="#fff" Height="1024" HorizontalAlignment="Left" Name="grid1" VerticalAlignment="Top" Width="471" Margin="6,0,0,0">
			<Grid Height="43" Background="#000" HorizontalAlignment="Left" Name="grid5" VerticalAlignment="Top" Width="470">
				<Label FontSize="23" Content="0011" HorizontalAlignment="Left" Foreground="#fff"
				Margin="8,2,0,6" Name="label3" VerticalAlignment="Center" Height="35" />
				<Label Content="Ref: 123456789" FontSize="18" Foreground="#fff"
				 HorizontalAlignment="Right" Margin="0,6,10,6" Name="label4" VerticalAlignment="Center" Height="31" />
			</Grid>
			<Grid Height="465" HorizontalAlignment="Left" Margin="0,436,0,0" Name="grid7" VerticalAlignment="Top" Width="470" Background="#E2E2E2">
				<Label Content="{x:Static resx:WinFormMainResource.KeypadInfo}" Height="40" FontSize="20"
				 HorizontalAlignment="Left" Margin="8,16,0,0" Name="label2" VerticalAlignment="Top" />
			</Grid>
		</Grid>
		<Grid Background="#FFF" HorizontalAlignment="Left" Margin="483,0,0,0" Name="grid2" VerticalAlignment="Top" Width="322">
			<ListBox HorizontalAlignment="Left" Name="ListMenuItem" VerticalAlignment="Top" Width="322" BorderBrush="#FFF" BorderThickness="0"
			ItemsSource="{Binding Path=CommonKitchenOrder}" Style="{StaticResource CustomLBStyle}">
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="Padding" Value="0"/>
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Button Style="{StaticResource MenuTile}" Command="{Binding DataContext.DefaulMenuSelected, RelativeSource={RelativeSource AncestorType=ListBox}}" 
						CommandParameter="{Binding Path=ItemId}" BorderBrush="#FFF" BorderThickness="0" 
						Margin="0,3,0,2" MinHeight="60" Width="320">
							<TextBlock Foreground="#FFF" FontSize="20" HorizontalAlignment="Left" Margin="10,0,15,0"
							VerticalAlignment="Center" Text="{Binding Path=ItemName}" TextWrapping="WrapWithOverflow"></TextBlock>
						</Button>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<!--<Button Style="{StaticResource MenuTile}" Command="{Binding DataContext.DefaulMenuSelected, RelativeSource={RelativeSource AncestorType=ListBox}}" 
						CommandParameter="{Binding Path=ItemId}" BorderBrush="#FFF" BorderThickness="0" 
						Margin="0,3,0,2" MinHeight="60" Width="320">
				<Label Foreground="#FFF" FontSize="22" HorizontalAlignment="Left" Margin="10,0,0,0"
							VerticalAlignment="Center">
					<AccessText TextWrapping="WrapWithOverflow">
					aaaaaaaaaaaa lajdfl ladkfjl ljadflj lajfl lkajfdl
					ajdfljadlf
					jadflj
					adflj
					</AccessText>
				</Label>
			</Button>-->
		</Grid>
		<Grid Visibility="{Binding GridUserVisibility}"
		Background="#FFFFFF" Height="1024" HorizontalAlignment="Left" Margin="811,0,0,0" Name="grid3" VerticalAlignment="Top" Width="462">
			<Grid Height="60" HorizontalAlignment="Left" Name="grid8" VerticalAlignment="Top" Width="462">
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<Button Style="{StaticResource MenuTile}"
				Height="60" Background="#6CB23F" Foreground="White" FontSize="22"
				HorizontalAlignment="Center" Name="button4" VerticalAlignment="Center" Width="231">
					<Label Foreground="#FFF" FontSize="22" HorizontalAlignment="Center" Margin="10,0,0,0"
							VerticalAlignment="Center" Content="{x:Static resx:WinFormMainResource.SelectAll}"></Label>
				</Button>
				<Button Style="{StaticResource MenuTile}" Grid.Column="1" Height="60" Background="#B7B7B7" Foreground="White"
				HorizontalAlignment="Left" Name="button12" VerticalAlignment="Top" Width="231">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<Label Content="{x:Static resx:WinFormMainResource.Quantity}" FontSize="22" VerticalAlignment="Center" />
						<Label Content="{Binding Path=UserInGroup.Count}" FontSize="22" Margin="-7,0,0,0"
						VerticalAlignment="Center" HorizontalAlignment="Center"></Label>
					</StackPanel>
				</Button>
			</Grid>
			<Grid Background="#E2E2E2" HorizontalAlignment="Left" Margin="0,63,0,0" Name="grid9" VerticalAlignment="Top" Width="462">
				<ListBox ItemsSource="{Binding Path=UserInGroup}" Style="{StaticResource CustomLBStyle}" Margin="2,3,3,2" BorderThickness="0">
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="Padding" Value="0"/>
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
							<Button Command="{Binding DataContext.DefaultEmployeeSelected, RelativeSource={RelativeSource AncestorType=ListBox}}" 
							CommandParameter="{Binding Path=SysId}"
							Height="69" Style="{StaticResource EmployeeInGroupTile}" Background="#fff" Padding="0" Margin="0,0,0,5"
							HorizontalAlignment="Center" Name="button16" VerticalAlignment="Top" Width="455" >
								<StackPanel Height="69" HorizontalAlignment="Left" Name="border1" 
							 VerticalAlignment="Center" Width="455" Orientation="Horizontal">
								<Image Source="pack://application:,,,/Images/no-avatar.jpg"
									Name="image2" Stretch="Fill" Width="69" HorizontalAlignment="Left" Height="69"/>
								<Grid Height="69" Name="grid10" Width="385" VerticalAlignment="Center" HorizontalAlignment="Right" Background="Lavender">
									<Label Content="{Binding Path=FullName}" FontSize="22" Height="41" HorizontalAlignment="Left" 
										VerticalAlignment="Center" Margin="10,15,0,13" />
									<Button VerticalAlignment="Center" HorizontalAlignment="Right" BorderBrush="Lavender" Margin="0,1,2,0" Background="Lavender"
										BorderThickness="0" Name="button20" FontSize="22" Width="61" Height="65" Style="{StaticResource MenuTile}" >
										<Label Content="..." FontSize="35" Height="67" Foreground="Red" 
											HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,12" />
									</Button>
								</Grid>
							</StackPanel>
						</Button>

					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			</Grid>
		</Grid>
		<!--Mouse.PreviewMouseDown="GridActionButton_PreviewMouseDown"-->
		<Grid Background="#fff" Height="145" HorizontalAlignment="Left" Margin="6,291,0,0" 
		Name="GridActionButton" VerticalAlignment="Top" Width="470">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Button Command="{Binding Path=PickRoomCommand}"
			Style="{StaticResource OrderTileButton}" Content="{x:Static resx:WinFormMainResource.PickRoom}" Height="65" HorizontalAlignment="Left" FontSize="22"
			Margin="-1,5,0,0" Name="button1" VerticalAlignment="Top" Width="228" Background="#6cb23f" Foreground="#fff" BorderBrush="{Binding Path=BorderButtonPickRoom}" />

			<Button Command="{Binding Path=ChooseDishesCommand}" FontSize="22"
			Style="{StaticResource OrderTileButton}" Content="{x:Static resx:WinFormMainResource.ChooseDishes}" Height="65" HorizontalAlignment="Left" 
			Margin="0,5,0,0" Name="button2" VerticalAlignment="Top" Width="228" Background="#6cb23f" Foreground="#fff" BorderBrush="{Binding Path=BorderButtonChooseDishes}" Grid.Column="1" />

			<Button Command="{Binding Path=PickGroupCommand}" FontSize="22"
			Style="{StaticResource OrderTileButton}" Content="{x:Static resx:WinFormMainResource.PickGroup}" Grid.Row="1" Height="65" HorizontalAlignment="Left" 
			Margin="-1,1,0,0" Name="button3" VerticalAlignment="Top" Width="228" Background="#6cb23f" Foreground="#fff" BorderBrush="{Binding Path=BorderButtonPickGroup}" />
		</Grid>
		<Grid Height="236" HorizontalAlignment="Left" Background="#e2e2e2"
		 Margin="6,49,0,0" Name="grid6" VerticalAlignment="Top" Width="470">
			<Image Source="pack://application:,,,/Images/no-avatar.jpg" Height="181" HorizontalAlignment="Left" Name="image1" Stretch="Fill" VerticalAlignment="Top" Width="178" Margin="0,-1,0,0" />
			<Grid Height="177" HorizontalAlignment="Left" Margin="178,3,0,0" Name="grid4" VerticalAlignment="Top" Width="292">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Label Content="{Binding Path=EmployeeInfo.FullNameUpper}" FontWeight="Bold" Foreground="#4091BD" Height="40"
				FontSize="20" HorizontalAlignment="Left" Margin="6,5,0,44" Name="label1" VerticalAlignment="Center" Grid.RowSpan="2" />
				<Label Content="{Binding Path=EmployeeInfo.NickName}" FontSize="20" FontWeight="Bold" Height="40" HorizontalAlignment="Left" Margin="12,43,0,6" Name="textBlock1" VerticalAlignment="Center" Grid.RowSpan="2" />
				<Label Grid.Row="1" Content="{Binding Path=EmployeeInfo.Code}" ContentStringFormat="#{0} " Height="40"
				FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="12,38,0,11" Name="textBlock2" VerticalAlignment="Center" Grid.RowSpan="2" />
				<Border Background="#fff" Grid.Row="2" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280" Margin="6,36,6,11" Grid.RowSpan="2">
					<TextBlock Margin="0,5,0,0" FontSize="20" FontWeight="Bold" Height="30" Name="textBlock3" 
					Text="{Binding Path=EmployeeInfo.DeparmentNameDetails}" Width="272" VerticalAlignment="Center" />
				</Border>
			</Grid>
			<Border Background="#fff" BorderThickness="1" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Width="456" Margin="8,182,6,4">
				<TextBlock FontSize="22" Height="35" Name="textBlock4" Margin="0,5,0,0"
				 Text="{Binding Path=EmployeeInfo.LocationName}" VerticalAlignment="Center" HorizontalAlignment="Center" />
			</Border>
		</Grid>
		<Grid Height="400" HorizontalAlignment="Left" Margin="14,480,0,0" Name="gridKeyPad" VerticalAlignment="Top" Width="452">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Grid Grid.Row="3">
				<Button Style="{StaticResource buttonKeypad}" Name="button5"
				 BorderThickness="1" Command="{Binding Path=NumPadPressed}" CommandParameter="NUMPAD7" Margin="0,10,-5,-2">7</Button>
			</Grid>
			<Grid Grid.Column="1" Grid.Row="3">
				<Button Style="{StaticResource buttonKeypad}" x:Name="button6" 
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD8" BorderThickness="1" Content="8" Margin="12,10,-17,-2" />
			</Grid>
			<Grid Grid.Column="2" Grid.Row="3">
				<Button Style="{StaticResource buttonKeypad}" x:Name="button7" 
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD9" Content="9" Margin="24,10,-28,-2" Grid.RowSpan="2" />
			</Grid>
			<Grid Grid.Column="3" Grid.Row="1" Grid.ColumnSpan="2">
				<Button x:Name="button8" Command="{Binding NumPadReleased}" CommandParameter="BACK" Margin="33,4,4,4" Style="{StaticResource buttonKeypad}">
					<!--<Path Stretch="Fill" Width="33" Height="21" Data="F1M555.0371,274.4893L552.7871,276.7383L549.9861,273.9373L547.1991,276.7243L545.1131,274.6393L547.9001,271.8523L545.0101,268.9603L547.2601,266.7113L550.1501,269.6023L552.8921,266.8613L554.9761,268.9463L552.2361,271.6883z M555.3751,264.0003L544.8751,264.0003C543.1251,264.1253,535.0001,270.7503,535.0001,272.2503C535.0001,273.7503,543.1251,279.3753,544.8751,279.5003L555.3751,279.5003C558.8751,279.5003,559.3751,277.7093,559.3751,275.5003L559.3751,268.0003C559.3751,265.7913,558.7501,264.0003,555.3751,264.0003" Fill="#FF333333" />-->
					<Image Source="{Binding Path=ImageCancel}" Height="40" Width="42" />
				</Button>
			</Grid>
			<Grid Grid.Row="2">
				<Button Style="{StaticResource buttonKeypad}" x:Name="button9" 
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD4" Content="4" Margin="0,7,-5,1" />
			</Grid>
			<Grid Grid.Column="1" Grid.Row="2">
				<Button Style="{StaticResource buttonKeypad}" x:Name="button10" 
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD5" Content="5" Margin="12,7,-17,1" />
			</Grid>
			<Grid Grid.Column="2" Grid.Row="2">
				<Button Style="{StaticResource buttonKeypad}" x:Name="button11" 
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD6" Content="6" Margin="24,7,-27,1" />
			</Grid>
			<Grid Grid.Row="1">
				<Button x:Name="button13"  Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD1" Content="1" Margin="0,4,-5,4" />
			</Grid>
			<Grid Grid.Column="1" Grid.Row="1">
				<Button x:Name="button14"  Style="{StaticResource buttonKeypad}"
				 Command="{Binding NumPadPressed}" CommandParameter="NUMPAD2" Content="2" Margin="12,4,-17,4" />
			</Grid>
			<Grid Grid.Column="2" Grid.Row="1">
				<Button Style="{StaticResource buttonKeypad}" x:Name="button15" 
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD3" Content="3" Margin="24,4,-27,4" />
			</Grid>
			<Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
				<Button Style="{StaticResource buttonKeypad}" x:Name="button17" 
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD0" Content="0" Margin="0,14,-28,-6" />
			</Grid>
			<Grid Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,78,0,2" Grid.RowSpan="2">
				<Button FontWeight="Black" x:Name="button18"  FontSize="31" Style="{StaticResource buttonKeypad}"
				 Command="{Binding Path=ReceiveCommand}" Content="{x:Static resx:WinFormMainResource.ReceiveUpper}" Margin="33,9,4,-1" />
			</Grid>
			<Grid Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2">
				<Button FontWeight="Black" x:Name="buttonKeyH"  FontSize="31" Style="{StaticResource buttonKeypad}"
				Command="{Binding Path=CancelCommand}" CommandParameter="NUMPADS" Content="{x:Static resx:WinFormMainResource.Cancel}" Margin="33,14,4,-6" />
			</Grid>
			<Grid Grid.Column="3" Grid.Row="3" Grid.ColumnSpan="2">
				<Button FontWeight="Black" x:Name="button19"  FontSize="31" Style="{StaticResource buttonKeypad}"
				Command="{Binding Path=AddCommand}" CommandParameter="NUMPADM" Content="{x:Static resx:WinFormMainResource.Add}" Margin="33,10,4,-2" />
			</Grid>
			<Grid Grid.ColumnSpan="5" Height="60">
				<Border VerticalAlignment="Center" HorizontalAlignment="Center" Height="60" Width="450">
					<Label Width="450" Height="60" Content="{Binding Result}" HorizontalContentAlignment="Right" VerticalAlignment="Center" FontSize="35" Background="#fff"/>
				</Border>
			</Grid>
		</Grid>
	</Grid>




</UserControl>
