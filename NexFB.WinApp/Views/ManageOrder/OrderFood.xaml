<UserControl 
	x:Class="NexFB.WinApp.Views.ManageOrder.OrderFood"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d" 
	xmlns:converter="clr-namespace:NexFB.WinApp.Converter"
	xmlns:local="clr-namespace:NexFB.WinApp.DependencyProperties"
	xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
	d:DesignHeight="{Binding DataContext.ScreenHeight, RelativeSource={RelativeSource AncestorType=Window}}" 
	d:DesignWidth="{Binding DataContext.ScreenWidth, RelativeSource={RelativeSource AncestorType=Window}}">
	<UserControl.Resources>
		<converter:RangeToBooleanConverter x:Key="conv"/>
		<converter:StringFormatConverter x:Key="stringConverter" />
	</UserControl.Resources>

	<Grid>
		<Grid Mouse.PreviewMouseDown="Grid_PreviewMouseDown">
			<!--Grid Left-->
			<Grid Width="471" Height="{Binding DataContext.ScreenHeight, RelativeSource={RelativeSource AncestorType=Window}}" 
			HorizontalAlignment="Left" Name="grid1" VerticalAlignment="Top"  Margin="6,5,0,0" Background="#fff">
				<Grid Height="43" Background="#000" HorizontalAlignment="Left" Name="grid5" VerticalAlignment="Top" Width="470">
					<Label FontSize="23" Content="{Binding Path=OrderNo}" HorizontalAlignment="Left" Foreground="#fff"
				Margin="8,2,0,6" Name="label3" VerticalAlignment="Center" Height="35" />
					<Label Content="{Binding Path=ReferenceCode}" FontSize="18" Foreground="#fff" ContentStringFormat="Ref: {0} "
				 HorizontalAlignment="Right" Margin="0,6,10,6" Name="label4" VerticalAlignment="Center" Height="31" />
				</Grid>
				<Grid HorizontalAlignment="Left" Margin="0,436,0,0" Name="grid7" VerticalAlignment="Stretch" Width="470" Background="#F0F0F0">
					<Grid.RowDefinitions>
						<RowDefinition Height="45"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<Label Content="{x:Static resx:WinFormMainResource.KeypadInfo}" FontSize="19" HorizontalAlignment="Left" 
					Margin="8,10,0,0" Name="label2" VerticalAlignment="Center" />
					<Grid HorizontalAlignment="Left" Height="{Binding DataContext.KeypadHeight, RelativeSource={RelativeSource AncestorType=Window}}"
						Name="gridKeyPad" Width="452" Grid.Row="1" VerticalAlignment="Top">
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
							<ColumnDefinition />
							<ColumnDefinition />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Grid Grid.Row="3" Visibility="{Binding NumPadVisible}">
							<Button Style="{StaticResource buttonKeypad}" Content="7"
				 BorderThickness="1" Command="{Binding Path=NumPadPressed}" CommandParameter="NUMPAD7" Margin="0,10,-5,-2" ></Button>
						</Grid>
						<Grid Grid.Row="3" Visibility="{Binding KeyPadVisible}">
							<Button Style="{StaticResource buttonKeypad}"  Content="C"
				 BorderThickness="1" Command="{Binding Path=NumPadPressed}" CommandParameter="NUMPADC" Margin="0,10,-5,-2" ></Button>
						</Grid>

						<Grid Grid.Row="4">
							<Button Style="{StaticResource buttonKeypad}" Name="buttonNumPad"
				 BorderThickness="1" Command="{Binding Path=ChangeKeyPad}" CommandParameter="NUMPAD7" Margin="0,14,-5,-6">
								<Image Source="pack://application:,,,/Images/arrow-icon.png" Height="51" Width="27" />
							</Button>
						</Grid>
						<Grid Grid.Column="1" Grid.Row="3" Visibility="{Binding NumPadVisible}">
							<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD8" BorderThickness="1" Content="8" Margin="12,10,-17,-2" />
						</Grid>
						<Grid Grid.Column="1" Grid.Row="3" Visibility="{Binding KeyPadVisible}">
							<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPADL" BorderThickness="1" Content="L" Margin="12,10,-17,-2" />
						</Grid>

						<Grid Grid.Column="2" Grid.Row="3" Visibility="{Binding NumPadVisible}">
							<Button Style="{StaticResource buttonKeypad}" x:Name="button7" 
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD9" Content="9" Margin="24,10,-28,-2" Grid.RowSpan="2" />
						</Grid>
						<Grid Grid.Column="3" Grid.Row="1" Grid.ColumnSpan="2">
							<Button x:Name="button8" Command="{Binding NumPadReleased}" Margin="33,4,4,4" Style="{StaticResource buttonKeypad}">
								<!--<Path Stretch="Fill" Width="33" Height="21" Data="F1M555.0371,274.4893L552.7871,276.7383L549.9861,273.9373L547.1991,276.7243L545.1131,274.6393L547.9001,271.8523L545.0101,268.9603L547.2601,266.7113L550.1501,269.6023L552.8921,266.8613L554.9761,268.9463L552.2361,271.6883z M555.3751,264.0003L544.8751,264.0003C543.1251,264.1253,535.0001,270.7503,535.0001,272.2503C535.0001,273.7503,543.1251,279.3753,544.8751,279.5003L555.3751,279.5003C558.8751,279.5003,559.3751,277.7093,559.3751,275.5003L559.3751,268.0003C559.3751,265.7913,558.7501,264.0003,555.3751,264.0003" Fill="#FF333333" />-->
								<Image Source="pack://application:,,,/Images/multi.png" Height="40" Width="42" />
								<!--<Image Source="pack://application:,,,/Images/button_cancel.png" Height="40" Width="42" />-->
							</Button>
						</Grid>
						<Grid Grid.Row="2" Visibility="{Binding NumPadVisible}">
							<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD4" Content="4" Margin="0,7,-5,1" />
						</Grid>
						<Grid Grid.Row="2" Visibility="{Binding KeyPadVisible}">
							<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPADN" Content="N" Margin="0,7,-5,1" />
						</Grid>

						<Grid Grid.Column="1" Grid.Row="2" Visibility="{Binding NumPadVisible}">
							<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD5" Content="5" Margin="12,7,-17,1" />
						</Grid>
						<Grid Grid.Column="1" Grid.Row="2" Visibility="{Binding KeyPadVisible}">
							<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPADE" Content="E" Margin="12,7,-17,1" />
						</Grid>

						<Grid Grid.Column="2" Grid.Row="2" Visibility="{Binding NumPadVisible}">
							<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD6" Content="6" Margin="24,7,-27,1" />
						</Grid>
						<Grid Grid.Column="2" Grid.Row="2" Visibility="{Binding KeyPadVisible}">
							<Button Style="{StaticResource buttonKeypad}" 
				Command="{Binding NumPadPressed}" CommandParameter="NUMPADX" Content="X" Margin="24,7,-27,1" />
						</Grid>

						<Grid Grid.Row="1" Visibility="{Binding NumVisible}">
							<Button   Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD1" Content="1" Margin="0,4,-5,4" />
						</Grid>
						<Grid Grid.Row="1" Visibility="{Binding KeyPadVisible}">
							<Button  Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPADH" Content="H" Margin="0,4,-5,4" />
						</Grid>

						<Grid Grid.Column="1" Grid.Row="1" Visibility="{Binding NumPadVisible}">
							<Button  Style="{StaticResource buttonKeypad}"
				 Command="{Binding NumPadPressed}" CommandParameter="NUMPAD2" Content="2" Margin="12,4,-17,4" />
						</Grid>

						<Grid Grid.Column="1" Grid.Row="1" Visibility="{Binding KeyPadVisible}">
							<Button  Style="{StaticResource buttonKeypad}"
				 Command="{Binding NumPadPressed}" CommandParameter="NUMPADM" Content="M" Margin="12,4,-17,4" />
						</Grid>

						<Grid Grid.Column="2" Grid.Row="1" Visibility="{Binding NumPadVisible}">
							<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD3" Content="3" Margin="24,4,-27,4" />
						</Grid>

						<Grid Grid.Column="2" Grid.Row="1" Visibility="{Binding KeyPadVisible}">
							<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPADS" Content="S" Margin="24,4,-27,4" />
						</Grid>

						<Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Visibility="{Binding NumPadVisible}">
							<Button Style="{StaticResource buttonKeypad}" x:Name="button17" 
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD0" Content="0" Margin="12,14,-28,-6" />
						</Grid>
						<Grid Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" >
							<Button FontWeight="Black" x:Name="button18"  FontSize="31" Style="{StaticResource buttonKeypad}"
				 Command="{Binding Path=ReceiveCommand}" Content="{x:Static resx:WinFormMainResource.ReceiveUpper}" Margin="33,7,4,1" />
						</Grid>
						<Grid Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2">
							<Button FontWeight="Black" x:Name="buttonKeyH"  FontSize="31" Style="{StaticResource buttonKeypad}"
				Command="{Binding Path=CancelCommand}" 
				CommandParameter="{Binding ElementName=ResultTextBlock}" 
				Content="{x:Static resx:WinFormMainResource.Cancel}" Margin="33,14,4,-6" />
						</Grid>
						<Grid Grid.Column="3" Grid.Row="3" Grid.ColumnSpan="2">
							<Button FontWeight="Black" x:Name="button19"  FontSize="31" Style="{StaticResource buttonKeypad}"
				Command="{Binding Path=AddCommand}" CommandParameter="NUMPADM" Content="{x:Static resx:WinFormMainResource.Add}" Margin="33,10,4,-2" />
						</Grid>
						<Grid Grid.ColumnSpan="5" Height="60">
							<Border VerticalAlignment="Center" HorizontalAlignment="Center" Height="60" Width="450" BorderThickness="2"
				 Mouse.PreviewMouseDown="ResultTextBlock_PreviewMouseDown" x:Name="ResultTextBlock">
								<Label Width="450" Height="60" Content="{Binding Result}" HorizontalContentAlignment="Right" VerticalAlignment="Center" FontSize="35" Background="#fff"/>
							</Border>
						</Grid>
					</Grid>
				</Grid>
			</Grid>

			<!--Grid Center-->
			<Grid Background="#FFF" HorizontalAlignment="Left" Margin="483,-1,0,0" Name="grid2" VerticalAlignment="Top" Width="322">
				<ListBox HorizontalAlignment="Left" Name="ListMenuItem" VerticalAlignment="Top" Width="322" BorderBrush="#FFF" BorderThickness="0"
			ItemsSource="{Binding Path=CommonKitchenOrder}" Style="{StaticResource CustomLBStyle}">
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Padding" Value="0"/>
						</Style>
					</ListBox.ItemContainerStyle>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Button Style="{StaticResource MenuTile}" Margin="0,3,0,2" MinHeight="60" Width="320"
						Command="{Binding DataContext.DefaulMenuSelected, RelativeSource={RelativeSource AncestorType=ListBox}}" 
						CommandParameter="{Binding Path=ItemId}">
								<Grid Width="320">
									<TextBlock Foreground="#FFF" FontSize="20" HorizontalAlignment="Left" Margin="10,0,25,0"
							VerticalAlignment="Center" Text="{Binding Path=ItemName}" TextWrapping="WrapWithOverflow"></TextBlock>
									<Label HorizontalAlignment="Right" Margin="0,0,5,0" VerticalAlignment="Center"
								 Foreground="Yellow" FontSize="20">
										<Label.Style>
											<Style TargetType="Label">
												<Style.Triggers>
													<DataTrigger Binding="{Binding Path=Quantity, Converter={StaticResource conv}}" Value="True">
														<Setter Property="Content" Value=""/>
													</DataTrigger>
													<DataTrigger Binding="{Binding Path=Quantity, Converter={StaticResource conv}}" Value="False">
														<Setter Property="Content" Value="{Binding Path=Quantity}"/>
														<Setter Property="ContentStringFormat" Value="x {0} "/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Label.Style>
									</Label>
								</Grid>

							</Button>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>

			<!--Grid Right-->
			<Grid Visibility="{Binding GridUserVisibility}"  MinWidth="462" Background="#FFFFFF" HorizontalAlignment="Right"
			 Name="grid3" VerticalAlignment="Top" Margin="3,5,7,0">
				<Grid Height="60" HorizontalAlignment="Left" Name="grid8" VerticalAlignment="Top" MinWidth="462">
					<Grid.ColumnDefinitions>
						<ColumnDefinition/>
						<ColumnDefinition/>
					</Grid.ColumnDefinitions>
					<Button Style="{StaticResource MenuTile}" Command="{Binding Path=SelectAllUserInGroup}"
						 Background="#6CB23F" Foreground="White" FontSize="22"
						HorizontalAlignment="Stretch" Name="button4" VerticalAlignment="Stretch">
						<Label Foreground="#fff" FontSize="22" HorizontalAlignment="Center" Margin="10,0,0,0"
							VerticalAlignment="Center" Content="{x:Static resx:WinFormMainResource.SelectAll}"></Label>
					</Button>
					<Button Style="{StaticResource MenuTile}" Grid.Column="1" Background="#B7B7B7" Foreground="White"
						HorizontalAlignment="Stretch" Name="button12" VerticalAlignment="Stretch" Margin="1,0,0,0">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
							<Label Content="{x:Static resx:WinFormMainResource.Quantity}" FontSize="22" VerticalAlignment="Center" />
							<Label Content="{Binding Path=UserInGroup.Count}" FontSize="22" Margin="-7,1,0,0" Foreground="#BD2828"
						VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Black" />
						</StackPanel>
					</Button>
				</Grid>
				<Grid Background="#E2E2E2" HorizontalAlignment="Stretch" Margin="0,63,0,0" Name="grid9" VerticalAlignment="Stretch">
					<ListBox ItemsSource="{Binding Path=UserInGroup}" Name="employeeOrder"
				Style="{StaticResource CustomLBStyle}" Margin="2,3,2,1" BorderThickness="0">
						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem">
								<Setter Property="Padding" Value="0"/>
							</Style>
						</ListBox.ItemContainerStyle>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Button Command="{Binding DataContext.DefaultEmployeeSelected, RelativeSource={RelativeSource AncestorType=ListBox}}" 
							CommandParameter="{Binding Path=SysId}"
							 Style="{StaticResource EmployeeInGroupTile}" Background="#fff" Padding="0" Margin="0,0,0,5"
							HorizontalAlignment="Stretch" Name="button16" VerticalAlignment="Stretch" >
									<Grid HorizontalAlignment="Stretch" Name="border1" Background="{Binding Path=EmployeeOrderMealColor}"
							 VerticalAlignment="Stretch" MinWidth="455"  Height="69">
										<Image Source="pack://application:,,,/Images/kahn.png"
									Name="image2" Stretch="Fill" Width="69" HorizontalAlignment="Left" Height="70" />
										<Grid Height="69" Name="grid10" VerticalAlignment="Center" HorizontalAlignment="Right" Background="{Binding Path=EmployeeOrderMealColor}">
											<Grid MinWidth="385">
												<Label Content="{Binding Path=NickNameHasOrdered}" FontSize="18" FontWeight="Black"
									 VerticalAlignment="Top" Margin="2,-5,-2,0" Foreground="#004069" />
												<DockPanel Margin="0,22,4,0" >
													<TextBlock FontSize="14" HorizontalAlignment="Left" Margin="15,3,0,0"
												local:TextBlockInline.FormattedText="{Binding Path=OrderSummary, Mode=OneWay, Converter={StaticResource stringConverter}}" 
												VerticalAlignment="Top" TextWrapping="WrapWithOverflow" Name="orderDetails"/>
												</DockPanel>
											</Grid>
										</Grid>
									</Grid>
								</Button>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>


				</Grid>
			</Grid>
			
			<!--Grid left data-->
			<Grid Background="#fff" Height="145" HorizontalAlignment="Left" Margin="6,291,0,0" 
					Name="GridActionButton" VerticalAlignment="Top" Width="470">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Button Command="{Binding Path=PickRoomCommand}"
			Style="{StaticResource OrderTileButton}" Content="{x:Static resx:WinFormMainResource.PickRoom}" Height="65" HorizontalAlignment="Left" FontSize="22"
			Margin="0,5,0,0" Name="button1" VerticalAlignment="Top" Width="234" Background="{Binding Path=BackgroundButtonPickRoom}" Foreground="#fff" BorderBrush="{Binding Path=BorderButtonPickRoom}" />

				<Button Command="{Binding Path=ChooseMainFoodCommand}" FontSize="22"
			Style="{StaticResource OrderTileButton}" Content="{x:Static resx:WinFormMainResource.ChooseDishes}" Height="65" HorizontalAlignment="Left" 
			Margin="1,5,0,0" Name="button2" VerticalAlignment="Top" Width="234" Background="{Binding Path=BackgroundButtonMainFood}" Foreground="#fff" BorderBrush="{Binding Path=BorderButtonMainFood}" Grid.Column="1" />

				<Button Command="{Binding Path=PickGroupCommand}" FontSize="22"
			Style="{StaticResource OrderTileButton}" Content="{x:Static resx:WinFormMainResource.PickGroup}" Grid.Row="1" Height="65"
			 HorizontalAlignment="Left" Name="button3" VerticalAlignment="Top" Width="234" Background="{Binding Path=BackgroundButtonPickGroup}" Foreground="#fff" BorderBrush="{Binding Path=BorderButtonPickGroup}" />

				<Button Style="{StaticResource OrderTileButton}" Command="{Binding Path=ChooseAlternativeFoodCommand}" BorderBrush="{Binding Path=BorderButtonAlternativeFood}"
			Content="{x:Static resx:WinFormMainResource.AlternativeFood}" Grid.Column="1" Grid.Row="1" Height="65" HorizontalAlignment="Left" Margin="1,0,0,0"
			Background="{Binding Path=BackgroundButtonAlternativeFood}" Foreground="#fff"  FontSize="22"
			 VerticalAlignment="Top" Width="234" />
			</Grid>
			<Grid Height="236" HorizontalAlignment="Left" Background="#e2e2e2"
				Margin="6,49,0,0" Name="grid6" VerticalAlignment="Top" Width="470">
				<Image Source="pack://application:,,,/Images/no-avatar.jpg" Height="180" HorizontalAlignment="Left" Name="image1" Stretch="Fill" VerticalAlignment="Top" Width="178" />
				<Grid Height="177" HorizontalAlignment="Left" Margin="178,3,0,0" Name="grid4" VerticalAlignment="Top" Width="292">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Label Content="{Binding Path=EmployeeInfo.FullNameUpper}" FontWeight="Bold" Foreground="#4091BD" Height="40"
				FontSize="20" HorizontalAlignment="Left" Margin="6,5,0,44" Name="label1" VerticalAlignment="Center" Grid.RowSpan="2" />
					<Label Content="{Binding Path=EmployeeInfo.NickName}" FontSize="20" FontWeight="Bold" Height="40" HorizontalAlignment="Left" Margin="12,43,0,6" VerticalAlignment="Center" Grid.RowSpan="2" />
					<Label Grid.Row="1" Content="{Binding Path=EmployeeInfo.Code}" ContentStringFormat="#{0} " Height="40"
				FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="12,38,0,11" Name="textBlock2" VerticalAlignment="Center" Grid.RowSpan="2" />
					<Border Background="#fff" Grid.Row="2" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280" Margin="6,36,6,11" Grid.RowSpan="2">
						<TextBlock Margin="0,5,0,0" FontSize="20" FontWeight="Bold" Height="30" Name="textBlock3" 
					Text="{Binding Path=EmployeeInfo.DeparmentNameDetails}" Width="272" VerticalAlignment="Center" />
					</Border>
				</Grid>
				<Border Background="#fff" BorderThickness="2" Height="50"
			 HorizontalAlignment="Center" VerticalAlignment="Center" Width="463" Margin="3,182,4,4">
					<TextBlock FontSize="22" Height="35" Name="textBlock4" Margin="0,5,0,0"
				 Text="{Binding Path=LocationName}" VerticalAlignment="Center" HorizontalAlignment="Center" />
				</Border>
			</Grid>
			
		</Grid>
		<Rectangle Visibility="{Binding OverlayVisible}"
		 Height="{Binding DataContext.ScreenHeight, RelativeSource={RelativeSource AncestorType=Window}}" 
		Width="{Binding DataContext.ScreenWidth, RelativeSource={RelativeSource AncestorType=Window}}"
		HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1" Fill="#000" Opacity=".4" Margin="0" />
	</Grid>
	




</UserControl>
