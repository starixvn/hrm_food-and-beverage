<UserControl 
	x:Class="NexFB.WinApp.Views.ManageOrder.OrderFood"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d" 
	xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
	d:DesignHeight="1024" d:DesignWidth="1280">
	<UserControl.Resources>
		<DropShadowEffect x:Key="DropShadowEffect" ShadowDepth="1" Direction="-90" BlurRadius="5" />
		<Style TargetType="Label">
			<Setter Property="FontSize" Value="22"/>
		</Style>
		<LinearGradientBrush x:Key="IPhoneSteelBackground" EndPoint="0.5,1.272" StartPoint="0.5,0">
			<GradientStop Color="#FF9097A3" Offset="0"/>
			<GradientStop Color="#FF444D5B" Offset="1"/>
		</LinearGradientBrush>

		<Style x:Key="buttonBorder" TargetType="Border" >
			<Setter Property="Button.Effect" Value="{StaticResource DropShadowEffect}"/>
			<Setter Property="Margin" Value="4"/>
		</Style>

		<Style TargetType="Button">
			<!--<Setter Property="ClickMode" Value="Press"/>-->
			<Setter Property="Margin" Value="4"/>
			<!--<Setter Property="Button.Effect" Value="{StaticResource DropShadowEffect}"/>-->
			<Setter Property="FontSize" Value="24"/>
		</Style>
	</UserControl.Resources>

	<Grid>
		<Grid Background="#E6E6E6" Height="1024" HorizontalAlignment="Left" Name="grid1" VerticalAlignment="Top" Width="455" Margin="6,0,0,0">
			<Image  Source="pack://application:,,,/Images/no-avatar.jpg"
			Height="192" HorizontalAlignment="Left" Name="image1" Stretch="Fill" VerticalAlignment="Top" Width="172" />
			<Border Background="#fff" BorderThickness="1" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Width="449" Margin="2,194,2,794">
				<TextBlock FontSize="17"
				Height="24" Name="textBlock4" Text="3A - MTD - Khu phòng ăn" VerticalAlignment="Center" HorizontalAlignment="Center"/>
			</Border>
			<Label Content="{x:Static resx:WinFormMainResource.KeypadInfo}" FontSize="17"
			 Height="33" HorizontalAlignment="Left" Margin="16,339,0,0" Name="label2" VerticalAlignment="Top" Width="327" />
			<Grid Height="313" HorizontalAlignment="Left" Margin="6,374,0,0" Name="gridKeyPad" VerticalAlignment="Top" Width="445">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid Grid.Row="3">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button Name="button5" Background="WhiteSmoke" BorderThickness="1" Command="{Binding Path=NumPadPressed}" CommandParameter="NUMPAD7">7</Button>
				</Grid>
				<Grid Grid.Column="1" Grid.Row="3">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button x:Name="button6" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPAD8" BorderThickness="1" Content="8" />
				</Grid>
				<Grid Grid.Column="2" Grid.Row="3">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button x:Name="button7" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPAD9" Content="9" />
				</Grid>
				<Grid Grid.Column="3" Grid.Row="1" Grid.ColumnSpan="2">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button x:Name="button8" Command="{Binding NumPadReleased}" CommandParameter="BACK">
						<!--<Path Stretch="Fill" Width="33" Height="21" Data="F1M555.0371,274.4893L552.7871,276.7383L549.9861,273.9373L547.1991,276.7243L545.1131,274.6393L547.9001,271.8523L545.0101,268.9603L547.2601,266.7113L550.1501,269.6023L552.8921,266.8613L554.9761,268.9463L552.2361,271.6883z M555.3751,264.0003L544.8751,264.0003C543.1251,264.1253,535.0001,270.7503,535.0001,272.2503C535.0001,273.7503,543.1251,279.3753,544.8751,279.5003L555.3751,279.5003C558.8751,279.5003,559.3751,277.7093,559.3751,275.5003L559.3751,268.0003C559.3751,265.7913,558.7501,264.0003,555.3751,264.0003" Fill="#FF333333" />-->
						<Image Source="{Binding Path=ImageCancel}" Height="40" Width="42" /> 
					</Button>
				</Grid>
				<Grid Grid.Row="2">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button x:Name="button9" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPAD4" Content="4" />
				</Grid>
				<Grid Grid.Column="1" Grid.Row="2">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button x:Name="button10" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPAD5" Content="5" />
				</Grid>
				<Grid Grid.Column="2" Grid.Row="2">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button x:Name="button11" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPAD6" Content="6" />
				</Grid>
				<Grid Grid.Row="1">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button x:Name="button13" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPAD1" Content="1" />
				</Grid>
				<Grid Grid.Column="1" Grid.Row="1">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button x:Name="button14" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPAD2" Content="2" />
				</Grid>
				<Grid Grid.Column="2" Grid.Row="1">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button x:Name="button15" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPAD3" Content="3" />
				</Grid>
				<Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button x:Name="button17" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPAD0" Content="0" />
				</Grid>
				<Grid Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" >
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button FontWeight="Black" x:Name="button18" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPADH" Content="{x:Static resx:WinFormMainResource.ReceiveUpper}"/>
				</Grid>
				<Grid Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" >
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button FontWeight="Black" x:Name="buttonKeyH" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPADS" Content="{x:Static resx:WinFormMainResource.Add}" />
				</Grid>
				<Grid Grid.Column="3" Grid.Row="3" Grid.ColumnSpan="2" >
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="4" />
					<Button FontWeight="Black" x:Name="button19" Background="WhiteSmoke" Command="{Binding NumPadPressed}" CommandParameter="NUMPADM" Content="{x:Static resx:WinFormMainResource.Cancel}" />
				</Grid>
				<Grid Grid.ColumnSpan="5">
					<Border Style="{StaticResource buttonBorder}" Background="Black" CornerRadius="0" />
					<Label Content="{Binding Result}" HorizontalContentAlignment="Right" Background="WhiteSmoke" Margin="4" />
				</Grid>
			</Grid>
		</Grid>
		<Grid Background="LightBlue" Height="1024" HorizontalAlignment="Left" Margin="467,0,0,0" Name="grid2" VerticalAlignment="Top" Width="394" />
		<Grid Background="BlanchedAlmond" Height="1024" HorizontalAlignment="Left" Margin="865,0,0,0" Name="grid3" VerticalAlignment="Top" Width="408" />
		<Grid Height="186" HorizontalAlignment="Left" Margin="184,6,0,0" Name="grid4" VerticalAlignment="Top" Width="277">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Label Content="ANGEL DI MARIA" FontWeight="Bold" Foreground="#4091BD"
			FontSize="20" HorizontalAlignment="Left" Margin="6,6,0,0" Name="label1" VerticalAlignment="Center" />
			<TextBlock Text="FIDEO" Grid.Row="1" FontSize="18" FontWeight="Bold"
			Height="23" HorizontalAlignment="Left" Margin="12,4,0,0" Name="textBlock1" VerticalAlignment="Center" />
			<TextBlock Grid.Row="2" Text="#12345" FontSize="18" FontWeight="Bold"
			Height="23" HorizontalAlignment="Left" Margin="12,10,0,0" Name="textBlock2"  VerticalAlignment="Center" />
			<Border Background="#fff" Grid.Row="3" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" Width="270" Margin="3,2,4,2">
				<TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="Bold" Height="30" Name="textBlock3" Text="MANCHESTER UTD" Width="257" VerticalAlignment="Center" />
			</Border>
		</Grid>
		<Grid Mouse.PreviewMouseDown="GridActionButton_PreviewMouseDown"
		Background="#fff" Height="100" HorizontalAlignment="Left" Margin="9,233,0,0" Name="GridActionButton" VerticalAlignment="Top" Width="449">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Button Command="{Binding Path=PickRoomCommand}"
			Style="{StaticResource OrderTileButton}" Content="{x:Static resx:WinFormMainResource.PickRoom}" Height="44" HorizontalAlignment="Left"
			Margin="2,5,0,0" Name="button1" VerticalAlignment="Top" Width="220" Background="#49C960" Foreground="#fff" BorderBrush="{Binding Path=BorderButtonPickRoom}" />

			<Button Command="{Binding Path=ChooseDishesCommand}"
			Style="{StaticResource OrderTileButton}" Content="{x:Static resx:WinFormMainResource.ChooseDishes}" Grid.Column="1" Height="44" HorizontalAlignment="Left" 
			Margin="2,5,0,0" Name="button2" VerticalAlignment="Top" Width="220" Background="#49C960" Foreground="#fff" BorderBrush="{Binding Path=BorderButtonChooseDishes}"/>

			<Button Command="{Binding Path=PickGroupCommand}"
			Style="{StaticResource OrderTileButton}" Content="{x:Static resx:WinFormMainResource.PickGroup}" Grid.Row="1" Height="44" HorizontalAlignment="Left" 
			Margin="2,1,0,0" Name="button3" VerticalAlignment="Top" Width="220" Background="#49C960" Foreground="#fff" BorderBrush="{Binding Path=BorderButtonPickGroup}" />
		</Grid>
	</Grid>




</UserControl>
