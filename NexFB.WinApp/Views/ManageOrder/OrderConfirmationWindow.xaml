<Window x:Class="NexFB.WinApp.Views.ManageOrder.OrderConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
        WindowStyle="None" SizeToContent="WidthAndHeight"
		 Topmost="False" ShowInTaskbar="False" ResizeMode="NoResize" BorderBrush="Silver" BorderThickness="1">
	<Window.Resources>
		<Color x:Key="customBlue"  A="255"   R="54" G="95" B="177"  />
		<SolidColorBrush x:Key="customBlueBrush" Color="{StaticResource customBlue}"></SolidColorBrush>
		<SolidColorBrush x:Key="customBlueBrushOpacity" Color="LightGray" Opacity="0.11"></SolidColorBrush>
		<Style x:Key="calcyListbox"  TargetType="ListBox">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBox">
						<Grid >
							<Grid.RowDefinitions>
								<RowDefinition Height="45"></RowDefinition>
								<RowDefinition></RowDefinition>
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Height="45" VerticalAlignment="Center" Background="#E1E1E1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="50"/>
									<ColumnDefinition Width="170"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="70"/>
									<ColumnDefinition Width="150"/>
								</Grid.ColumnDefinitions>
								<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="0"></Border>
								<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="1"></Border>
								<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="2"></Border>
								<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="3"></Border>
								<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="4"></Border>
								<TextBlock Text="{x:Static resx:WinFormMainResource.sharps}" FontSize="16" FontFamily="Segoe Ui Dark"
								 Foreground="#014A81" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />

								<TextBlock Text="{x:Static resx:WinFormMainResource.Member}" FontSize="16" FontFamily="Segoe Ui Dark" 
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />

								<TextBlock Text="{x:Static resx:WinFormMainResource.Dishes}" FontSize="16" FontFamily="Segoe Ui Dark"  
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="2" />

								<TextBlock Text="{x:Static resx:WinFormMainResource.Quantity1}" FontSize="16" FontFamily="Segoe Ui Dark"  
								Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="3" />

								<TextBlock Text="{x:Static resx:WinFormMainResource.UnitPrice}" FontSize="16" FontFamily="Segoe Ui Dark" 
								 Foreground="#014A81" SnapsToDevicePixels="True"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="4" />
							</Grid>
							<Border Margin="0,0,0,0" Grid.Row="1" SnapsToDevicePixels="True"  Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
								<ItemsPresenter />
							</Border>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="noStyleToListboxItem" TargetType="ListBoxItem">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border>
							<ContentPresenter></ContentPresenter>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<StackPanel Height="auto">
		<Grid Width="1000" Background="#66B5D6" Height="40" VerticalAlignment="Top">
			<Label Content="{x:Static resx:WinFormMainResource.OrderFoodConfirmation}" FontSize="17" FontWeight="Black"
						 HorizontalAlignment="Left" Margin="0" Name="label1" VerticalAlignment="Center" />
		</Grid>

		<Grid Width="978" VerticalAlignment="Stretch">
			<Grid HorizontalAlignment="Left" Margin="0,0,0,0" Name="grid1" VerticalAlignment="Top" Width="954">
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>

				<DockPanel Grid.Row="1" VerticalAlignment="Center" Margin="12,10,0,0" Height="36">
					<Label Content="{x:Static resx:WinFormMainResource.OrderOwner}" 
				FontSize="16" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" />
					<Label Content="{Binding Path=EmployeeInfo.FullName}" FontWeight="Bold" FontSize="16" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" />
					<Label Content="{Binding Path=EmployeeInfo.NickName}" ContentStringFormat=" ({0})"
					 FontWeight="Bold" FontSize="16" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" />
					<Label Content=" - " FontWeight="Bold" FontSize="16" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" />
					<Label Content="{Binding Path=EmployeeInfo.Code}" ContentStringFormat="#{0} "
					FontWeight="Bold" FontSize="16" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" />
				</DockPanel>
				<DockPanel Grid.Row="2" VerticalAlignment="Center" Margin="12,0,0,0" Height="36">
					<Label Content="{x:Static resx:WinFormMainResource.PlaceOfDelivery}" 
				FontSize="16" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" />
					<Label Content="{Binding Path=LocationName}" FontSize="16" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" />
				</DockPanel>
			</Grid>

			<Grid HorizontalAlignment="Left" Margin="12,95,0,0" Name="grid2" VerticalAlignment="Top" Width="965">
				<StackPanel Orientation="Vertical">
					<Grid MaxHeight="300">
						<ScrollViewer>
							<ListBox BorderThickness="1,0,1,1" Margin="0,0,20,0" Background="{StaticResource customBlueBrushOpacity}" 
						HorizontalContentAlignment="Stretch" ItemsSource="{Binding OrderPreviewData}" Style="{StaticResource calcyListbox}" ItemContainerStyle="{StaticResource noStyleToListboxItem}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid Height="40" Margin="0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="50"/>
												<ColumnDefinition Width="170"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="70"/>
												<ColumnDefinition Width="150"/>
											</Grid.ColumnDefinitions>
											<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="0"></Border>
											<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="1"></Border>
											<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="2"></Border>
											<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="3"></Border>
											<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="4"></Border>
											<TextBlock Text="{Binding Path=OrderNo}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0"/>
											<TextBlock Text="{Binding Path=NickName}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"/>
											<TextBlock Text="{Binding Path=Dishes}" FontSize="16" Foreground="{Binding Path=Color}"
										HorizontalAlignment="Left" VerticalAlignment="Center"  Grid.Column="2" Margin="5,0,0,0" />
											<TextBlock Text="{Binding Path=Quantity}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="3"/>
											<TextBlock Text="{Binding Path=Price}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"  Grid.Column="4" Margin="0,0,7,0"/>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>

						</ScrollViewer>
					</Grid>
					<Grid Height="40" Margin="0,0,20,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="70"/>
							<ColumnDefinition Width="150"/>
						</Grid.ColumnDefinitions>
						<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="0"></Border>
						<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="1"></Border>
						<Border BorderThickness="1" BorderBrush="Lavender" Grid.Column="2"></Border>
						<Label HorizontalAlignment="Right" Content="{x:Static resx:WinFormMainResource.Total}" FontWeight="Black"/>
						<Label Grid.Column="1" HorizontalAlignment="Center" Content="{Binding TotalOrder}" FontWeight="Black" />
						<Label Grid.Column="2" HorizontalAlignment="Right" Foreground="Red" Margin="0,0,2,0"
						Content="{Binding TotalPrice}"  FontWeight="Black"/>
					</Grid>
					<Grid VerticalAlignment="Bottom" Margin="0,20,0,15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Button Background="#66B5D6" Foreground="White" Command="{Binding Path=SaveOrderCommand}"
						CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
					Content="{x:Static resx:WinFormMainResource.Confirmation}" Height="45" Style="{StaticResource TileButton}"
					HorizontalAlignment="Right" Margin="0,0,10,0" Name="button1" VerticalAlignment="Top" Width="125" FontSize="20"/>

						<Button Background="#EF4339" Foreground="White"
					Grid.Column="1" Content="{x:Static resx:WinFormMainResource.Back}" Height="45" Style="{StaticResource TileButton}"
					HorizontalAlignment="Left" VerticalAlignment="Top" Width="125" Margin="10,0,0,0" 
					Command="{Binding Path=CancelDialogOrderConfirmation}" FontSize="20"
		CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"/>
					</Grid>
				</StackPanel>
			</Grid>
		</Grid>

	</StackPanel>

</Window>
