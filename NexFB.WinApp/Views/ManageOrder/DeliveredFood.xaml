<UserControl 
	x:Class="NexFB.WinApp.Views.ManageOrder.DeliveredFood"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
	mc:Ignorable="d" d:DesignHeight="1024" d:DesignWidth="1280">

	<ScrollViewer>
		<Grid  VerticalAlignment="Top" x:Name="GridDeliveredFood" Margin="0,0,0,0">
			<ListBox Margin="-1,-1,-17,-3" BorderBrush="#cf4fde" ItemsSource="{Binding Path=DeliveredMeals}" x:Name="ListDeliveredFood">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border BorderThickness="1,1,0,1" BorderBrush="#cf4fde" Margin="0,-1,0,-1" Padding="0" CornerRadius="0" Height="100">
							<Grid Background="#e1e1e1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition/>
									<ColumnDefinition/>
									<ColumnDefinition/>
								</Grid.ColumnDefinitions>

								<!--Order number-->
								<Grid Grid.Column="0" Height="100" Width="120" Background="#464646" VerticalAlignment="Top" Margin="-9,0,0,0">
									<Label Content="{Binding Path=TwoDigitOrderNo}" Foreground="White" HorizontalAlignment="Center" FontSize="50" VerticalAlignment="Center" Margin="4,0,4,31" Height="69"></Label>
									<Border BorderBrush="Transparent" BorderThickness="0" Height="34" HorizontalAlignment="Left" Margin="9,58,0,0" VerticalAlignment="Top" Width="107">
										<TextBlock Foreground="White" FontSize="13" Text="{Binding Path=RegisterDateString}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
									</Border>

								</Grid>

								<!--Order details information-->
								<Grid Grid.Column="1" Width="950" Margin="10, 5, 0, 0" Height="97">
									<StackPanel>
										<!--Display order owner, room...-->
										<Grid Height="32">
											<Grid.RowDefinitions>
												<RowDefinition/>
											</Grid.RowDefinitions>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="auto"/>
												<ColumnDefinition Width="auto"/>
												<ColumnDefinition Width="auto"/>
												<ColumnDefinition Width="auto"/>
												<ColumnDefinition Width="auto"/>
												<ColumnDefinition Width="auto"/>
											</Grid.ColumnDefinitions>

											<Border HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource RoomNumberStyle}" Grid.Column="0">
												<TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Text="{Binding Path=FloorName}" VerticalAlignment="Center"/>
											</Border>
											<Label Grid.Column="1" Content="{Binding Path=VnmName}" />
											<Label Grid.Column="2" Content="-" />
											<Label Grid.Column="3" Content="{Binding Path=NickName}" />
											<Label Grid.Column="4" Content="{Binding Path=Code}" ContentStringFormat="#{0}" />
											<Label Grid.Column="5">
												<StackPanel Orientation="Horizontal">
													<Image Width="25" Height="25" Source="pack://application:,,,/Images/phone-icon.png" Stretch="Uniform"/>
													<TextBlock Text="{Binding Path=Phone}" Margin="4,0,0,0"/>
												</StackPanel>
											</Label>
										</Grid>

										<!--Display number of meals-->
										<Grid Height="33">
											<ListBox Background="#e1e1e1" Margin="53,0,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Path=ListMenu}" BorderThickness="0">
												<ListBox.ItemsPanel>
													<ItemsPanelTemplate >
														<WrapPanel Orientation="Horizontal" ScrollViewer.PanningMode="VerticalOnly" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
													</ItemsPanelTemplate>
												</ListBox.ItemsPanel>
												<ListBox.ItemTemplate>
													<DataTemplate>
														<Grid>
															<Grid.ColumnDefinitions>
																<ColumnDefinition/>
																<ColumnDefinition/>
															</Grid.ColumnDefinitions>
															<Label Foreground="#e76957" FontSize="15" Grid.Column="0" Content="{Binding Path=MenuVnmName}" ContentStringFormat=" {0} :"></Label>
															<Label FontWeight="Black" FontSize="15" Grid.Column="1" Content="{Binding Path=QuantityPerTotal}" Margin="0,0,20,0"></Label>
														</Grid>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>
										</Grid>

										<!--Display general order note-->
										<Label Height="32">
											<StackPanel Orientation="Horizontal">
												<Image Stretch="Uniform" Width="15" Height="15">
													<Image.Style>
														<Style TargetType="{x:Type Image}">
															<Style.Triggers>
																<DataTrigger Binding="{Binding Path=HasNote}" Value="True">
																	<Setter Property="Source" Value="pack://application:,,,/Images/alert.png"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Image.Style>
												</Image>
												<TextBlock Foreground="Red" Text="{Binding Path=Remark}" FontSize="14" Margin="4,0,0,0"/>
											</StackPanel>
										</Label>
									</StackPanel>
								</Grid>

								<!--Order status-->
								<Grid Grid.Column="2" Width="203" Height="100" VerticalAlignment="Top">
									<Button Command="{Binding ElementName=ListDeliveredFood, Path=DataContext.UndoOrderCommand}" 
									 CommandParameter="{Binding Path=OrderId}" Background="#FA5934" Foreground="White" Style="{StaticResource TileButton}" Content="{x:Static resx:WinFormMainResource.Back}"
									 HorizontalAlignment="Left" Margin="6,6,0,0" Name="button1" VerticalAlignment="Top" Width="84" Height="33"/>
									<Button Command="{Binding ElementName=ListDeliveredFood, Path=DataContext.EditOrderCommand}" CommandParameter="{Binding Path=OrderId}"
									 Background="#3A95FC"  Foreground="White" Style="{StaticResource TileButton}" Content="{x:Static resx:WinFormMainResource.Edit}"
									 Height="33" HorizontalAlignment="Left" Margin="99,6,0,0"
									 Name="button2" VerticalAlignment="Top" Width="75" />
								</Grid>
							</Grid>
						</Border>

					</DataTemplate>
				</ListBox.ItemTemplate>

			</ListBox>
		</Grid>

	</ScrollViewer>
</UserControl>
