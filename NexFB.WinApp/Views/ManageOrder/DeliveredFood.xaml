<UserControl 
	x:Class="NexFB.WinApp.Views.ManageOrder.DeliveredFood"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
	mc:Ignorable="d" d:DesignHeight="1024" d:DesignWidth="1280">

	<Grid VerticalAlignment="Top" x:Name="GridDeliveredFood">
		<ListBox Margin="-1,0,0,0" BorderBrush="#FA5934" ItemsSource="{Binding Path=DeliveredMeals}" x:Name="ListDeliveredFood" ScrollViewer.VerticalScrollBarVisibility="Visible">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border BorderThickness="1,1,0,1" BorderBrush="#FA5934" Margin="0" Padding="0" CornerRadius="0" Height="150">
						<Grid Background="White">
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition/>
								<ColumnDefinition/>
							</Grid.ColumnDefinitions>

							<!--Order number-->
							<StackPanel Grid.Column="0" Height="150" Width="180" Background="Black" VerticalAlignment="Top" Margin="-9,0,0,0">
								<Label Content="{Binding Path=OrderId}" Foreground="White" HorizontalAlignment="Center" FontSize="70" VerticalAlignment="Center"></Label>
								<Label Content="{Binding Path=RegisterDate}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
							</StackPanel>

							<!--Order details information-->
							<Grid Grid.Column="1" Width="895" Margin="10, 10, 10, 10" Height="150">
								<StackPanel>
									<!--Display order owner, room...-->
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition/>
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="auto"/>
											<ColumnDefinition Width="auto"/>
											<ColumnDefinition Width="auto"/>
											<ColumnDefinition Width="auto"/>
											<ColumnDefinition Width="auto"/>
											<ColumnDefinition Width="auto"/>
										</Grid.ColumnDefinitions>
										<Border Style="{StaticResource RoomNumberStyle}" Grid.Column="0">
											<Label HorizontalAlignment="Center" FontWeight="Bold" Content="{Binding Path=FloorName}">
											</Label>
										</Border>
										<Label Grid.Column="1" Content="{Binding Path=VnmName}" />
										<Label Grid.Column="2" Content="-" />
										<Label Grid.Column="3" Content="{Binding Path=NickName}" />
										<Label Grid.Column="4" Content="{Binding Path=Code}" ContentStringFormat="#{0}" />
										<Label Grid.Column="5">
											<StackPanel Orientation="Horizontal">
												<Image Width="20" Height="20" Source="pack://application:,,,/Images/phone-icon.png" Stretch="Uniform"/>
												<TextBlock Text="{Binding Path=Phone}" Margin="4,0,0,0"/>
											</StackPanel>
										</Label>
									</Grid>

									<!--Display number of meals-->
									<Grid Height="63">
										<ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Path=ListMenu}" BorderThickness="0">
											<ListBox.ItemsPanel>
												<ItemsPanelTemplate >
													<WrapPanel Orientation="Horizontal" ScrollViewer.PanningMode="VerticalOnly" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
												</ItemsPanelTemplate>
											</ListBox.ItemsPanel>
											<ListBox.ItemTemplate>
												<DataTemplate>
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition/>
															<ColumnDefinition/>
														</Grid.ColumnDefinitions>
														<Label FontSize="15" Grid.Column="0" Content="{Binding Path=MenuVnmName}" ContentStringFormat=" {0} :"></Label>
														<Label FontSize="15" Grid.Column="1" Content="{Binding Path=QuantityPerTotal}" Margin="0,0,20,0"></Label>
													</Grid>
												</DataTemplate>
											</ListBox.ItemTemplate>
										</ListBox>
									</Grid>

									<!--Display general order note-->
									<Label>
										<StackPanel Orientation="Horizontal">
											<Image Stretch="Uniform" Width="18" Height="18">
												<Image.Style>
													<Style TargetType="{x:Type Image}">
														<Style.Triggers>
															<DataTrigger Binding="{Binding Path=HasNote}" Value="True">
																<Setter Property="Source" Value="pack://application:,,,/Images/alert.png"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Image.Style>
											</Image>
											<TextBlock Foreground="Red" Text="{Binding Path=Remark}" FontSize="14" Margin="4,0,0,0"/>
										</StackPanel>
									</Label>
								</StackPanel>
							</Grid>

							<!--Order status-->
							<Grid Grid.Column="2" Width="170" Height="150" VerticalAlignment="Top">
								<Button Command="{Binding ElementName=ListDeliveredFood, Path=DataContext.UnDeliverMealCommand}" CommandParameter="{Binding Path=OrderId}"
								 Background="#FA5934" Foreground="White" Style="{StaticResource TileButton}" Content="{x:Static resx:WinFormMainResource.Back}" Margin="4,7,0,107" Width="83" Height="36" HorizontalAlignment="Left" />

								<Button  Command="{Binding ElementName=ListDeliveredFood, Path=DataContext.EditMealCommand}" CommandParameter="{Binding Path=OrderId}"
								Background="#3A95FC"  Foreground="White" Style="{StaticResource TileButton}" Content="{x:Static resx:WinFormMainResource.Edit}" Margin="0,7,15,107" Height="36" HorizontalAlignment="Right" Width="55" />
							</Grid>
						</Grid>
					</Border>

				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Grid>
</UserControl>
