<UserControl 
	x:Class="NexFB.WinApp.Views.ManageOrder.WaitingMeal"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
	mc:Ignorable="d" 
	d:DesignHeight="{Binding DataContext.ScreenHeight, RelativeSource={RelativeSource AncestorType=Window}}" 
	d:DesignWidth="{Binding DataContext.ScreenWidth, RelativeSource={RelativeSource AncestorType=Window}}">

		<!--Main Manage Pending Food Screen-->
		<Grid VerticalAlignment="Top" x:Name="GridPendingFood" Margin="3,0,0,0" >
			<ListBox Margin="0" BorderBrush="#fff" ItemsSource="{Binding Path=WaitingMeals}" x:Name="ListPendingFood">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Height="95" BorderThickness="1,1,0,1" BorderBrush="#fff" Margin="0,-1,0,0" Padding="0" CornerRadius="0">
							<Grid Background="#e1e1e1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition/>
									<ColumnDefinition/>
									<ColumnDefinition/>
								</Grid.ColumnDefinitions>

								<!--Order number-->
								<Grid Width="105" Height="95" Background="#464646" VerticalAlignment="Top" Margin="-9,0,0,0">
									<Label Height="60" Content="{Binding Path=TwoDigitOrderNo}" Foreground="White" HorizontalAlignment="Center" FontSize="45" VerticalAlignment="Center" Margin="4,5,4,31"></Label>
									<Border Height="30" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" Margin="4,62,0,0" VerticalAlignment="Top" Width="103">
									<TextBlock Margin="0,7,0,0" Foreground="White" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Center">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Style.Triggers>
													<DataTrigger Binding="{Binding Path=CurrentStatusId}" Value="1">
														<Setter Property="Text" Value="{Binding Path=RegisterDateString}"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding Path=CurrentStatusId}" Value="2">
														<Setter Property="Text" Value="{Binding Path=ReceiveDateString}"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding Path=CurrentStatusId}" Value="3">
														<Setter Property="Text" Value="{Binding Path=ReceiveDateString}"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>

								</Grid>

								<!--Order details information-->
							<Grid Grid.Column="1" Width="{Binding DataContext.DisplayWidth, RelativeSource={RelativeSource AncestorType=Window}}" Margin="10, 10, 0, 0">
									<StackPanel>
										<!--Display order owner, room...-->
										<Grid Height="32">
											<Grid.RowDefinitions>
												<RowDefinition/>
											</Grid.RowDefinitions>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="auto"/>
												<ColumnDefinition Width="auto"/>
												<ColumnDefinition Width="auto"/>
												<ColumnDefinition Width="auto"/>
												<ColumnDefinition Width="auto"/>
												<ColumnDefinition Width="auto"/>
											</Grid.ColumnDefinitions>

										<Border Margin="0,0,0,-5" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource RoomNumberStyle}" Grid.Column="0">
												<TextBlock HorizontalAlignment="Center" FontSize="20" Text="{Binding Path=FloorName}" VerticalAlignment="Center"/>
											</Border>
											<Label Grid.Column="1" Content="{Binding Path=VnmName}" />
											<Label Grid.Column="2" Content="-" />
											<Label Grid.Column="3" Content="{Binding Path=NickName}" />
											<Label Grid.Column="4" Content="{Binding Path=Code}" ContentStringFormat="#{0}" />
											<Label Grid.Column="5">
												<StackPanel Orientation="Horizontal">
													<Image Width="25" Height="25" Source="pack://application:,,,/Images/phone-icon.png" Stretch="Uniform"/>
													<TextBlock Text="{Binding Path=Phone}" Margin="4,0,0,0"/>
												</StackPanel>
											</Label>
										</Grid>

										<!--Display number of meals-->
										<Grid Height="30" Margin="0,8,0,0">
										<!--<ScrollViewer Margin="0,-10,0,0">-->
											<ListBox Background="#e1e1e1" Margin="0" Style="{StaticResource CustomLBStyle}"
											 ItemsSource="{Binding Path=DisplayListMenu}" BorderThickness="0">
											<ListBox.Template>
												<ControlTemplate>
													<ItemsPresenter />
												</ControlTemplate>
											</ListBox.Template>
											<ListBox.ItemsPanel>
													<ItemsPanelTemplate >
														<StackPanel Orientation="Horizontal"/>
													</ItemsPanelTemplate>
												</ListBox.ItemsPanel>
												<ListBox.ItemTemplate>
													<DataTemplate>
														<Grid Margin="0,-15,0,0">
															<Grid.ColumnDefinitions>
																<ColumnDefinition/>
																<ColumnDefinition/>
															</Grid.ColumnDefinitions>
															<Label Foreground="#e76957" FontSize="15" Grid.Column="0" Content="{Binding Path=MenuVnmName}" ContentStringFormat=" {0} :"></Label>
														<Label FontWeight="Black" FontSize="15" Grid.Column="1" Content="{Binding Path=QuantityOrder}" Margin="0,0,11,0"></Label>
														</Grid>

													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>
										<!--</ScrollViewer>-->
										</Grid>

										<!--Display general order note-->
										<Label Margin="0,-15,0,0">
											<StackPanel Orientation="Horizontal">
												<Image Stretch="Uniform" Height="14">
													<Image.Style>
														<Style TargetType="{x:Type Image}">
															<Style.Triggers>
																<DataTrigger Binding="{Binding Path=HasNote}" Value="True">
																	<Setter Property="Source" Value="pack://application:,,,/Images/alert.png"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Image.Style>
												</Image>
												<TextBlock Foreground="Red" Text="{Binding Path=Remark}" FontSize="13" Margin="4,1,0,0"/>
											</StackPanel>
										</Label>
									</StackPanel>
								</Grid>

								<!--Order status-->
								<Grid Grid.Column="2" Width="150" VerticalAlignment="Top">
								<Button Height="40" Width="85" Content="{Binding Path=ButtonLabel}"
								 Foreground="White" Style="{StaticResource TileButton}"  Margin="38,8,20,40" />
								</Grid>
							</Grid>
						</Border>

					</DataTemplate>
				</ListBox.ItemTemplate>

			</ListBox>
		</Grid>
</UserControl>
