<Window x:Class="NexFB.WinApp.Views.EmployeeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EmployeeSelectionWindow" Height="220" Width="700"
		 Topmost="True" ShowInTaskbar="False" WindowStyle="None">
	<Window.Resources>
		<!-- Style to get rid of the selection visual -->
		<Style TargetType="{x:Type ListBoxItem}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ListBoxItem}">
						<ContentPresenter />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Grid Background="Black">
		<Label Foreground="#fff" Content="{Binding Path=MessageHeader}" Height="40" FontSize="20"
		HorizontalAlignment="Left" Margin="12,0,0,0" Name="label1" VerticalAlignment="Top" />
		<ListBox VerticalAlignment="Top" Background="Black" BorderBrush="Black" 
		ItemsSource="{Binding DuplicateUser}" SelectedItem="{Binding SelectedItem}" Margin="0,36,0,0">
			<ListBox.ItemTemplate>
				<DataTemplate >
					<Viewbox Height="30"
					HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,7,0,0">
						<RadioButton Foreground="#fff" Content="{Binding Path=EmployeeSelectionGeneralInfo}" GroupName="Properties" >
							<RadioButton.IsChecked>
								<Binding Path="IsChecked" Mode="TwoWay" />
							</RadioButton.IsChecked>
					</RadioButton>
					</Viewbox>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
		<Button Command="{Binding Path=SaveDialogCommand}"
		CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
		Style="{StaticResource TileButton}" Background="Blue" Content="OK" Foreground="White" Margin="0,0,90,0"
		Height="35" HorizontalAlignment="Right" Name="button1" VerticalAlignment="Bottom" Width="75" />
		<Button Command="{Binding Path=CancelDialogCommand}"
		CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"  
		Style="{StaticResource TileButton}" Content="Cancel" Height="35" Background="#e2e2e2" Margin="0,0,5,0"
		HorizontalAlignment="Right" Name="button2" VerticalAlignment="Bottom" Width="75" />
	</Grid>
</Window>
