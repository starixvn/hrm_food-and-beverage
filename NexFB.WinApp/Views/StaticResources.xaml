<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:col="clr-namespace:System.Collections;assembly=mscorlib" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	 xmlns:vm="clr-namespace:NexFB.WinApp.ViewModels"
	 xmlns:views="clr-namespace:NexFB.WinApp.Views.ManageOrder">

	 <!--Switch view according to ViewModel-->
	<DataTemplate DataType="{x:Type vm:PendingFoodViewModel}">
		<views:PendingFood />
	</DataTemplate>
	<DataTemplate DataType="{x:Type vm:DeliveredFoodViewModel}">
		<views:DeliveredFood />
	</DataTemplate>

	<!--Common Style-->
	<Style TargetType="{x:Type Control}" x:Key="baseStyle">
		<Setter Property="FontSize" Value="18" />
	</Style>
	<Style TargetType="{x:Type Button}" BasedOn="{StaticResource baseStyle}" />
	<Style TargetType="{x:Type Label}" BasedOn="{StaticResource baseStyle}" />

	<Style x:Key="roomNumberStyle" TargetType="Border">
		<Setter Property="CornerRadius" Value="9" />
		<Setter Property="Background" Value="#C2FCEF" />
		<Setter Property="Width" Value="70" />
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>



	<DataTemplate x:Key="foodItemTemplate">
		<Border BorderThickness="1" BorderBrush="#77B1FC" Margin="0" Padding="0" CornerRadius="0">
			<Grid Background="White" >
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>

				<!--Order number-->
				<StackPanel Grid.Column="0" Height="150" Width="220" Background="Black">
					<Label Content="{Binding Path=Name}" Foreground="White" HorizontalAlignment="Center" FontSize="70" VerticalAlignment="Center"></Label>
					<Label Content="{Binding Path=OrderDate}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
				</StackPanel>

				<!--Order details-->
				<Grid Grid.Column="1" Width="880" Margin="10, 10, 10, 10">
					<StackPanel>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="auto"/>
									<ColumnDefinition Width="auto"/>
									<ColumnDefinition Width="auto"/>
									<ColumnDefinition Width="auto"/>
									<ColumnDefinition Width="auto"/>
									<ColumnDefinition Width="auto"/>
								</Grid.ColumnDefinitions>
								<Border Style="{StaticResource roomNumberStyle}" Grid.Column="0">
									<Label HorizontalAlignment="Center" Content="{Binding Path=Room}" />
								</Border>
								<Label Grid.Column="1" Content="{Binding Path=RoomDescription}" />
								<Label Grid.Column="2" Content="-" />
								<Label Grid.Column="3" Content="{Binding Path=OrderOwner}" />
								<Label Grid.Column="4" Content="{Binding Path=EmployeeId}" ContentStringFormat="#{0}" />
								<Label Grid.Column="5">
									<StackPanel Orientation="Horizontal">
										<Image Source="pack://application:,,,/Images/phone-icon.png" Stretch="Uniform"/>
										<TextBlock Text="{Binding Path=RoomPhone}" Margin="4,0,0,0"/>
									</StackPanel>
								</Label>
							</Grid>
					</StackPanel>
				</Grid>

				<!--Order status-->
				<TextBlock Grid.Column="2" Text="{Binding Path=Age}" Width="150" Background="Aqua"/>
			</Grid>
		</Border>
	</DataTemplate>

</ResourceDictionary>