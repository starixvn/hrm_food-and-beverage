<ResourceDictionary 
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
	xmlns:col="clr-namespace:System.Collections;assembly=mscorlib" 
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="clr-namespace:NexFB.WinApp.ViewModels"
	xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
	xmlns:views="clr-namespace:NexFB.WinApp.Views.ManageOrder">

	<!--Switch view according to Data Type-->
	<DataTemplate DataType="{x:Type vm:PendingFoodViewModel}">
		<views:PendingFood />
	</DataTemplate>

	<DataTemplate DataType="{x:Type vm:DeliveredFoodViewModel}">
		<views:DeliveredFood />
	</DataTemplate>

	<DataTemplate DataType="{x:Type vm:OrderFoodViewModel}">
		<views:OrderFood />
	</DataTemplate>

	<!--Common Style-->
	<!--Default NexFB WinApp Style-->
	<Style TargetType="{x:Type Control}" x:Key="BaseStyle">
		<Setter Property="FontSize" Value="18" />
	</Style>
	<Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}" />
	<Style TargetType="{x:Type Label}" BasedOn="{StaticResource BaseStyle}" />

	<!--Style for display Room Name-->
	<Style x:Key="RoomNumberStyle" TargetType="Border">
		<Setter Property="CornerRadius" Value="9" />
		<Setter Property="Background" Value="#69E2FA" />
		<Setter Property="Width" Value="70" />
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>

	<!--Style for display when has order note in order request-->
	<Style TargetType="{x:Type Image}" x:Key="HasOrderNote">
		<Style.Triggers>
			<DataTrigger Binding="{Binding Path=HasNote}" Value="True">
				<Setter Property="Source" Value="pack://application:,,,/Images/alert.png"/>
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<!--Tile Button-->
	<!--Style for tile button-->
	<Style x:Key="TileButton" TargetType="Button">
		<Setter Property="FontSize" Value="18" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Name="border" CornerRadius="0" Background="{TemplateBinding Background}" BorderThickness="1">
						<ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center">
						</ContentPresenter>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="Button.IsDefaulted" Value="True">
							<Setter Property="BorderBrush" TargetName="border" Value="Red"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" TargetName="border" Value="#FFBEE6FD"/>
							<Setter Property="BorderBrush" TargetName="border" Value="#FF3C7FB1"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Background" TargetName="border" Value="#FFC4E5F6"/>
							<Setter Property="BorderBrush" TargetName="border" Value="#FF2C628B"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Background" TargetName="border" Value="#FFF4F4F4"/>
							<Setter Property="BorderBrush" TargetName="border" Value="#FFADB2B5"/>
							<Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="#FF838383"/>
						</Trigger>
						<DataTrigger Binding="{Binding Path=FoodOrderStatus}" Value="1">
							<Setter Property="Content" Value="{x:Static resx:WinFormMainResource.Receive}"></Setter>
							<Setter Property="Background" Value="#3A95FC"/>
							<Setter Property="Command" Value="{Binding ElementName=ListPendingFood, Path=DataContext.ReceiveOrderFoodCommand}"/>
							<!--<Setter Property="Command" Value="{Binding Path=DataContext.ReceiveOrderFoodCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}}"/>-->
							<Setter Property="CommandParameter" Value="{Binding Path=EmployeeCode}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding Path=FoodOrderStatus}" Value="2">
							<Setter Property="Content" Value="{x:Static resx:WinFormMainResource.Export}"></Setter>
							<Setter Property="Background" Value="#FA5934"/>
							<Setter Property="Command" Value="{Binding ElementName=ListPendingFood, Path=DataContext.ExportOrderFoodCommand}"/>
							<Setter Property="CommandParameter" Value="{Binding Path=EmployeeCode}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding Path=FoodOrderStatus}" Value="3">
							<Setter Property="Content" Value="{x:Static resx:WinFormMainResource.Back}"></Setter>
							<Setter Property="Background" Value="#FA5934"/>
							<Setter Property="Command" Value="{Binding ElementName=ListDeliveredFood, Path=DataContext.ExportOrderFoodCommand}"/>
							<Setter Property="CommandParameter" Value="{Binding Path=EmployeeCode}"/>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>