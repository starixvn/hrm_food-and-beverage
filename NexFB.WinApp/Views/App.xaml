<Application x:Class="NexFB.WinApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			  xmlns:views="clr-namespace:NexFB.WinApp.Views.ManageOrder"
			   xmlns:vm="clr-namespace:NexFB.WinApp.ViewModels"
             StartupUri="MainWindow.xaml">
	<Application.Resources>
		<DataTemplate DataType="{x:Type vm:PendingFoodViewModel}">
			<views:PendingFood />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:DeliveredFoodViewModel}">
			<views:DeliveredFood />
		</DataTemplate>
	</Application.Resources>
</Application>
