<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="App_Data\SpNames.xml" />
    <None Remove="logs\log.txt" />
    <None Remove="Service.svc" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="NLangDetect.Core">
      <HintPath>..\Dependencies\AutoDetectLanguage\NLangDetect.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="App_Data\SpNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </Content>
    <Content Include="logs\log.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Service.svc" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="CoreWCF" />
    <Using Include="CoreWCF.Configuration" />
    <Using Include="CoreWCF.Channels" />
    <Using Include="CoreWCF.Description" />
    <Using Include="System.Runtime.Serialization " />
    <Using Include="NexFB.WCFService" />
    <Using Include="Microsoft.Extensions.DependencyInjection.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CoreWCF.Primitives" Version="1.*" />
    <PackageReference Include="CoreWCF.Http" Version="1.*" />
    <PackageReference Include="Fanex.Data" Version="4.2.3" />
    <PackageReference Include="Fanex.Data.Repository" Version="4.2.3" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.2.3" />
    <PackageReference Include="Fanex.Logging" Version="2.0.0" />
    <PackageReference Include="Fanex.Logging.Extensions" Version="1.0.6.1" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.0.8" />
    <PackageReference Include="Fanex.Logging.Sentry" Version="1.0.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.8" />
  </ItemGroup>
</Project>