<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>
  <connectionStrings>
    <add name="NexFB" connectionString="packet size=4096; Data Source=10.18.200.114;TrustServerCertificate = true;Connect Timeout=60;Asynchronous Processing=true;Initial Catalog=FBM_Quinn;integrated security=false; user id=internalteam; password=d0KQL2j6R1N8hCLjYs44tQ==;" providerName="System.Data.SqlClient"/>
    <add name="SMSEPA" connectionString="packet size=4096; Data Source=10.18.200.114;TrustServerCertificate = true;Connect Timeout=60;Asynchronous Processing=true;Initial Catalog=SMSEPA;integrated security=false; user id=internalteam; password=d0KQL2j6R1N8hCLjYs44tQ==;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="TimerInterval" value="120"/>
    <add key="PhotoPathNexcel" value="D:\\Demo\\Images\\Nexcel"/>
    <add key="PhotoPathHongMa" value="D:\\Demo\\Images\\HongMa"/>
    <add key="PhotoPathSMS" value="D:\\Demo\\Images\\SMS"/>
    <add key="EnableNexcel" value="False"/>
    <add key="EnableHongMa" value="False"/>
    <add key="EnableSMS" value="False"/>
    <add key="EnableSyncDataForEPA" value="True"/>
    <add key="IsOnlyTransferPhoto" value="False"/>
    <add key="IsOnlyTransferPhotoForEPA" value="False"/>
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="SpName.xml" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IUserService" allowCookies="true"
          maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" />
        <binding name="BasicHttpBinding_IUserService1" allowCookies="true"
          maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" />
        <binding name="BasicHttpBinding_IUserService2" allowCookies="true"
          maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" />
        <binding name="BasicHttpBinding_ISynchronizeDataService" allowCookies="true"
          maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://tfs209.spvn.local:8464/Service.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IUserService"
        contract="NexcelService.IUserService" name="BasicHttpBinding_IUserService" />
      <endpoint address="http://tfs209.spvn.local:8465/Service.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IUserService1"
        contract="HongMaService.IUserService" name="BasicHttpBinding_IUserService1" />
      <endpoint address="http://tfs209.spvn.local:8466/Service.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IUserService2"
        contract="SMSService.IUserService" name="BasicHttpBinding_IUserService2" />
      <endpoint address="http://cp0081-quinn.spvn.local:8687/Service.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ISynchronizeDataService"
        contract="SynchronizeDataService.ISynchronizeDataService" name="BasicHttpBinding_ISynchronizeDataService" />
    </client>
  </system.serviceModel>
  <log4net debug="true">
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Log.txt"/>
      <appendToFile value="true"/>
      <rollingStyle value="Size"/>
      <maxSizeRollBackups value="10"/>
      <maximumFileSize value="10MB"/>
      <staticLogFileName value="true"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%-5p %d %5rms %-22.22c{1} %-18.18M - %m%n"/>
      </layout>
    </appender>
    <root>
      <level value="DEBUG"/>
      <appender-ref ref="RollingLogFileAppender"/>
    </root>
  </log4net>
</configuration>
