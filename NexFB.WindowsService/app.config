<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>
  <connectionStrings>
    <add name="NexFB" connectionString="packet size=4096; Data Source=10.19.10.140\SQLExpress;TrustServerCertificate = true;Connect Timeout=60;Asynchronous Processing=true;Initial Catalog=FBM_Quinn;integrated security=false; user id=internalteam; password=iftJ5aAHCdGe4yc8quUqSw==;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="TimerInterval" value="120"/>
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="SpName.xml" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
  <system.serviceModel>
    <bindings>
      <wsHttpBinding>
        <binding name="WSHttpBinding_IUserService" allowCookies="true"
                maxReceivedMessageSize="2147483647"
                maxBufferPoolSize="2147483647"/>
        <binding name="WSHttpBinding_IUserService1" allowCookies="true"
                maxReceivedMessageSize="2147483647"
                maxBufferPoolSize="2147483647"/>
        <binding name="WSHttpBinding_IUserService2" allowCookies="true"
                maxReceivedMessageSize="2147483647"
                maxBufferPoolSize="2147483647"/>
      </wsHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://tfs209.spvn.local:8464/Service.svc"
        binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IUserService"
        contract="NexcelService.IUserService" name="WSHttpBinding_IUserService">
        <identity>
          <dns value="localhost" />
        </identity>
      </endpoint>
      <endpoint address="http://tfs209.spvn.local:8465/Service.svc"
        binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IUserService1"
        contract="HongMaService.IUserService" name="WSHttpBinding_IUserService1">
        <identity>
          <dns value="localhost" />
        </identity>
      </endpoint>
      <endpoint address="http://tfs209.spvn.local:8466/Service.svc"
        binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IUserService2"
        contract="SMSService.IUserService" name="WSHttpBinding_IUserService2">
        <identity>
          <dns value="localhost" />
        </identity>
      </endpoint>
    </client>
  </system.serviceModel>
  <log4net debug="true">
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Log.txt"/>
      <appendToFile value="true"/>
      <rollingStyle value="Size"/>
      <maxSizeRollBackups value="10"/>
      <maximumFileSize value="10MB"/>
      <staticLogFileName value="true"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%-5p %d %5rms %-22.22c{1} %-18.18M - %m%n"/>
      </layout>
    </appender>
    <root>
      <level value="DEBUG"/>
      <appender-ref ref="RollingLogFileAppender"/>
    </root>
  </log4net>
</configuration>
