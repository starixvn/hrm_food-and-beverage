<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
        <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    </configSections>
    <connectionStrings>
        <add name="NexFB" connectionString="packet size=4096; Data Source=FOOD_SERVER\SQLEXPRESS;TrustServerCertificate = true;Connect Timeout=60;Asynchronous Processing=true;Initial Catalog=FBM;integrated security=false; user id=fbm; password=7m7/xo4m5N5yd6h2wx4/VQ==;" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <add key="TimerInterval" value="180" />
        <add key="PhotoPathNexcel" value="C:\\FnB\\Others\\Images\\Nexcel" />
        <add key="PhotoPathHongMa" value="C:\\FnB\\Others\\Images\\HongMa" />
        <add key="PhotoPathSMS" value="C:\\FnB\\Others\\Images\\SMS" />
        <add key="PhotoPathLuminet" value="C:\\FnB\\Others\\Images\\Luminet" />
        <add key="EnableNexcel" value="True" />
        <add key="EnableHongMa" value="True" />
        <add key="EnableSMS" value="True" />
        <add key="EnableLuminet" value="True" />
        <add key="IsTransferPhotoNexcel" value="True" />
        <add key="IsTransferPhotoHongMa" value="True" />
        <add key="IsTransferPhotoSMS" value="True" />
        <add key="IsTransferPhotoLuminet" value="True" />
        <!-- Sentry -->
        <add key="Sentry:Category" value="go" />
        <add key="Sentry:Dsn" value="https://0ce3d1ba6c99471e8bb6f188a2ba653e@sentry.starixplay.com/232" />
        <add key="Sentry:Timeout" value="10" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="SpName.xml" enableWatching="1" />
        </providers>
    </Fanex.Data.DbSettingProvider>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_ISynchronizeDataService" allowCookies="true"
                  maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" />
                <binding name="BasicHttpBinding_ISynchronizeDataService2" allowCookies="true"
                  maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" />
                <binding name="BasicHttpBinding_ISynchronizeDataService1" allowCookies="true"
                  maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" />
                <binding name="BasicHttpBinding_ISynchronizeDataService3" allowCookies="true"
                  maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://120.72.83.134:8464/service.svc"
              binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ISynchronizeDataService"
              contract="NexcelService.ISynchronizeDataService" name="BasicHttpBinding_ISynchronizeDataService" />
            <endpoint address="http://10.18.114.21:8466/service.svc"
              binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ISynchronizeDataService2"
              contract="SMSService.ISynchronizeDataService" name="BasicHttpBinding_ISynchronizeDataService2" />
            <endpoint address="http://116.193.68.26:8465/service.svc"
              binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ISynchronizeDataService1"
              contract="HongMaService.ISynchronizeDataService" name="BasicHttpBinding_ISynchronizeDataService1" />
            <endpoint address="http://120.72.83.134:8467/service.svc"
              binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ISynchronizeDataService3"
              contract="LuminetService.ISynchronizeDataService" name="BasicHttpBinding_ISynchronizeDataService3" />
        </client>
    </system.serviceModel>
    <log4net debug="true">
        <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
            <file value="logs/log.txt" />
            <appendToFile value="true" />
            <rollingStyle value="Size" />
            <maxSizeRollBackups value="10" />
            <maximumFileSize value="10MB" />
            <staticLogFileName value="true" />
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="%-5p %d %5rms %-22.22c{1} %-18.18M - %m%n" />
            </layout>
        </appender>
        <root>
            <level value="DEBUG" />
            <appender-ref ref="RollingLogFileAppender" />
        </root>
    </log4net>
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <dependentAssembly>
                <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
            </dependentAssembly>
        </assemblyBinding>
    </runtime>
</configuration>