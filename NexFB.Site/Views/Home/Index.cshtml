@using NexFB.Models.Authority
@using NexFB.Web
@model UserSession
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	var index = 1;
	var menuGroups = SessionManager.MenuGroups as IList<MenuGroup>;
}

<div class="row header">
	<a class="logo" href="/Ordering/Index">
        <img src="~/Src/Content/Site/Images/logo.png" alt="F&B" title="F&B"/>
    </a>
	<img src="data:image;base64,@ViewBag.Image" width="80" height="80"/>
	<div class="nav">
		<nav id="navbar-example" class="navbar navbar-static top-menu" role="navigation">
			<div class="bs-example-js-navbar-collapse">
				<ul class="nav navbar-nav">
				@if (menuGroups != null)
				{
					foreach (MenuGroup menuParentItem in menuGroups)
					{
						var childMenuItems = menuParentItem.MenuItems;
						if (childMenuItems != null && childMenuItems.Count() > 0)
						{
							var id = "drop" + index;

									<li class="dropdown">
										<a id="@id" href="#" data-role="button" class="dropdown-toggle" data-toggle="dropdown">@menuParentItem.Name<b class="caret"></b>
										</a>
										<ul class="dropdown-menu" data-role="button" aria-labelledby="@id">
											@foreach (var childMenu in childMenuItems)
					{
												<li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="@childMenu.MenuLink">@childMenu.Name</a>
												</li>
					}
										</ul>
									</li>
							index += 1;
						}
						else
						{
											<li>
												<a href="@menuParentItem.MenuLink" >@menuParentItem.Name</a>
											</li>
						}
					}
				}
			</div>
		</nav>
		<div id="user_utilities" class="user-info info" ng-controller="LogoutController">
			<h2>@Model.FullName - @Model.NickName
			</h2>
			<a class="dropdown-arrow" href="javascript:;">
			</a>
			<ol>
				<li>
					<a href="" ng-click="logout()">Logout</a>
				</li>
			</ol>
		</div>
	</div>
</div>

<div class="row" ng-view>
</div>
