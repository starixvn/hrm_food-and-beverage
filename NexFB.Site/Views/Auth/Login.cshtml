@using System.Web.Optimization
@model NexFB.Models.Authority.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Welcome to F&B</title>
    @Styles.Render("~/Src/Content/login/css")
</head>
<body>
    <div id="panel" class="container login">
        <div class="header-login row">
        </div>
        <div id="formContainer" class="row auth">
            @using (Html.BeginForm())
            {
                @Html.TextBoxFor(model => model.Username, new { placeholder = "Username", @class = "col-sm-12 username" })                  
                  
                @Html.TextBoxFor(model => model.Password, new { placeholder = "Password", type = "Password", @class = "col-sm-12 password" })                  
                
                <input type="submit" name="submit" class="col-sm-12 btn-submit" value="Log In" />
            }
            <div class="message-error">
                <i class="icon-error"></i>Invalid Username or Password. Please try again.
            </div>
        </div>
        
    </div>
    <footer id="copyright" class="copyright">
             © @DateTime.Today.Year by Nexcel Solutions. All rights reserved
        </footer>
</body>
</html>
