@using System.Web.Optimization
<!DOCTYPE html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7"> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8"> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9"> <![endif]-->
<!--[if gt IE 8]><!-->
@using NexFB.Resources
<html data-ng-app="appModule">
	<head>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		@Styles.Render("~/bundles/less")
		@Styles.Render("~/Src/Content/Common/css")
		@Styles.Render("~/NexFB/Src/Less")
		@RenderSection("Head", false)
		<title>@Lang.TitlePage</title>
	</head>
	<body>
		<div class="container-fluid page">
			@RenderBody()
		</div>
		@Scripts.Render("~/bundles/vendor")
		@Scripts.Render("~/bundles/app")
		@Scripts.Render("~/bundles/extensions")
		@Scripts.Render("~/bundles/signalr")
		<script src="~/signalr/hubs"></script>
	</body>
</html>