.monthbox {
	 .form-control {
		width: 76%;
		display: inline-block;
	}
	.input-group-btn {
		display: inline-block;
		> .btn {
			padding: 3px 8px 2px;
			position: relative;
			top: -2px;
		}
	}
}
.grid-title {
	background: #818181 !important;
	margin-bottom: 0;
	border: none;
	.grid-title-label {
		color: #fff;
	}
} 
.freegrid {
	border-top: 1px solid #373737;
}
.freegrid .freegrid thead th, .freegrid .grid-fixed-table thead th {
	border-color: #373737;
}
#monthlyReport.freegrid .row-footer-background{
	border-top: none;
}
.freegrid .col_footer_content.grid-fixed-table thead th,  .freegrid .row_footer_content.grid-fixed-table thead th, .freegrid .grid-fixed-table thead th.free-cell-bottom-left {
	border-color: #c5c5c5;
}
.freegrid .free-top-left table thead th, .freegrid .col_header table thead th {
	background: #606060;
}
.freegrid tr.parent-row-background td {
	background: #a0bbd2;
}
.list-employee-menu {
	padding: 3px 0;
}

