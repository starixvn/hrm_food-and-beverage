<div ng-controller="DefaultRegisterMeal">
	<table class="table table-bordered table-register" ng-if="policy.permission >= 1">
		<thead>
			<tr>
				<th class="width-percent-9">
				</th>
				<th class="width-percent-13 black" data-translate="Sun">
				</th>
				<th class="width-percent-13 black" data-translate="Mon">
				</th>
				<th class="width-percent-13 black" data-translate="Tue">
				</th>
				<th class="width-percent-13 black" data-translate="Wed">
				</th>
				<th class="width-percent-13 black" data-translate="Thu">
				</th>
				<th class="width-percent-13 black" data-translate="Fri">
				</th>
				<th class="width-percent-13 black" data-translate="Sat">
				</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td class="text-center lbl-week week-middle" >
					<a href="" ng-click="registerMealWeek(weekMeals)" ng-if="policy.permission == 2">
						{{"AllWeekdays" | translate}}
					</a>
					<span class="black" ng-if="policy.permission == 1">{{"AllWeekdays" | translate}}
					</span>
				</td>
				<td ng-repeat="date in weekMeals" ng-click="policy.permission != 2 || registerMeal(date, $index)"
					ng-class="{lastChild: $last}" class="pointer">
					<div ng-repeat="meal in date.Meals">
						<span get-class-by-name ng-class="mealClass" ng-show="meal.IsVegetarian != null" class="txt-name">{{meal.ShortName}}:
						</span> 
						<span class="icon-veg" ng-show="meal.IsVegetarian == 1">
						</span>
						<span class="icon-none-veg" ng-show="meal.IsVegetarian == 0">
						</span>
					</div>
				</td>
			</tr>
		</tbody>
	</table>
	<div class="txt-warning">
		<i class="glyphicon glyphicon-exclamation-sign icon-warning"></i>
		<label data-translate="DefaultRegistrationWarning" class="warning-registration"></label>
