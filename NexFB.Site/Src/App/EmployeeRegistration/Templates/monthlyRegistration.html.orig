        <ul class="list-unstyled list-inline">
            <li class="lbl-breakfast">B: {{"Breakfast" | translate}}</li>
            <li class="lbl-lunch">L: {{"Lunch" | translate}}</li>
            <li class="lbl-dinner">D: {{"Dinner" | translate}}</li>
            <li class="lbl-supper">S: {{"Supper" | translate}}</li>
        </ul>
