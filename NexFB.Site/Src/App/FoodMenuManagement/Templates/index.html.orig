    <div class="row table-menu">
        <table class="table table-bordered table-striped col-sm-12">
            <thead>
				<tr class="header-table">
					<th colspan="11">
						<div class="pull-left table-entries">
							<span data-translate="Show"></span>
							<select class="dropdown-entry" ng-model="entrySelected" ng-change="showEntries()"
								ng-options="entry for entry in entries">
							</select>
							<span data-translate="entries"></span>
						</div>
						<input type="text" ng-model="queryData" ng-change="search()" class="search-inline-textbox search pull-right">
					</th>
				</tr>
                <tr>
                    <th data-translate="SymbolCount"></th>
                    <th data-translate="FoodMenuVnm"></th>
                    <th data-translate="FoodMenuEng"></th>
                    <th data-translate="Meal"></th>
                    <th class="" data-translate="ShortVegetarian"></th>
                    <th class="width-170" data-translate="EmployeeType"></th>
                    <th class="width-120" data-translate="ShortPricePerMeal"></th>
                    <th class="width-120" data-translate="ShortPricePerDay"></th>
                    <th class="width-140" data-translate="FoodItems"></th>
                    <th class="width-60" data-translate="Active"></th>
                    <th class="width-80" data-translate="Action"></th>
                </tr>
            </thead>
            <tbody>
				<tr ng-repeat="foodMenu in pagedItems[currentPage] track by foodMenu.MenuId">
					<td class="text-center" ng-bind="$index + 1">
					</td>
					<td ng-bind="foodMenu.MenuVnmName">
					</td>
					<td ng-bind="foodMenu.MenuEngName">
					</td>
					<td>
						<div ng-if="foodMenu.Meals.length == 1">
							<span ng-bind="foodMenu.Meals[0].MealEngName"></span>
						</div>
						<div ng-if="foodMenu.Meals.length > 1">
							<ul class="group-toggle-item">
								<li ng-repeat="meal in foodMenu.Meals" ng-bind="meal.MealEngName"></li>
							</ul>
						</div>
					</td>
					<td>
						<span ng-if="foodMenu.IsVegetarian" data-translate="Yes"></span>
						<span ng-if="!foodMenu.IsVegetarian" data-translate="No"></span>
					</td>
					<td>
						<div ng-if="foodMenu.EmployeeTypes.length == 1">
							<span ng-bind="foodMenu.EmployeeTypes[0].EmployeeTypeName"></span>
						</div>
						<div ng-if="foodMenu.EmployeeTypes.length > 1">
							<ul class="group-toggle-item">
								<li ng-repeat="type in foodMenu.EmployeeTypes" ng-bind="type.EmployeeTypeName"></li>
							</ul>
						</div>
					</td>
					<td class="text-right" ng-bind="foodMenu.PricePerMeal">
					</td>
					<td class="text-right" ng-bind="foodMenu.PricePerDay">
					</td>
					<td>
						<span>{{foodMenu.NumberFoodItems}} {{"Selected" | translate}}</span>
					</td>
					<td class="text-center">
						<input type="checkbox" ng-checked="foodMenu.IsActive" />
					</td>
					<td class="text-center">
						<a class="glyphicon glyphicon-edit" href="" ng-click="edit(foodMenu)"></a>
						<a class="glyphicon glyphicon-remove icon-remove" href=""></a>
					</td>
				</tr>
				<tr ng-show="foodMenus.length == 0">
					<td class="empty-result" colspan="11" data-translate="EmptyResult">
					</td>
				</tr>
            </tbody>
			<tfoot>
				<tr>
					<td colspan="11" class="paging" >
						<pagination-bar></pagination-bar>
					</td>
				</tr>
			</tfoot>
        </table>
        <div class="note-menu">
            <ul class="list-unstyled list-inline">
                <li><b>P.P Meal: Price Per Meal</b></li>
                <li><b>P.P Day: Price Per Day</b></li>
            </ul>
        </div>
    </div>
</div>