<Window x:Class="NexFB.PosKitchen.Views.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:l="clr-namespace:NexFB.PosKitchen.DependencyProperties"
        Title="SettingWindow" Height="145" Width="298" ResizeMode="NoResize" Topmost="True"
		l:ControlBox.HasMaximizeButton="False"
		l:ControlBox.HasMinimizeButton="False">

	<Grid>
		<GroupBox Header="Print Mode" Height="66" HorizontalAlignment="Left" Name="groupBox1" VerticalAlignment="Top" Width="278">
			<Grid>
				<RadioButton IsChecked="{Binding Path=DevMode}" GroupName="Printer" Content="DEV" Height="16" HorizontalAlignment="Left" Margin="39,15,0,0" Name="radioDevMode" VerticalAlignment="Top" />
				<RadioButton IsChecked="{Binding Path=ReleaseMode}" GroupName="Printer" Content="RELEASE" Height="16" HorizontalAlignment="Left" Margin="125,15,0,0" Name="radioReleaseMode" VerticalAlignment="Top" />
			</Grid>
		</GroupBox>
		<Button Command="{Binding Path=SaveData}"  CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
		Background="Blue" Foreground="White" Style="{StaticResource TileButton}" Content="Save" Height="35" HorizontalAlignment="Left" Margin="103,69,0,0" Name="button1" VerticalAlignment="Top" Width="75" />
	</Grid>
</Window>
