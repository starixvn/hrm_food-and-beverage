<Window x:Class="NexFB.PosKitchen.Views.EmployeeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
        Title="EmployeeSelectionWindow" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
		 Topmost="True" ShowInTaskbar="False" WindowStyle="None">
	<Window.Resources>
		<!-- Style to get rid of the selection visual -->
		<Style TargetType="{x:Type ListBoxItem}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ListBoxItem}">
						<ContentPresenter />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Border BorderBrush="Silver" BorderThickness="1">
		<Grid Margin="15">
			<StackPanel Orientation="Vertical">
				<Border Margin="0,0,0,7" BorderBrush="Silver" BorderThickness="0,0,0,1" Height="40">
					<StackPanel Orientation="Horizontal" Margin="10,0,0,0">
						<Image Source="pack://application:,,,/Images/alert.png" Height="24" Width="24"/>
						<Label Content="{Binding Path=MessageHeader}" Height="40" FontSize="20"
					HorizontalAlignment="Left" Margin="5,3,0,0" Name="label1" VerticalAlignment="Top" Foreground="Red"/>
					</StackPanel>
				</Border>


				<ListBox VerticalAlignment="Top" Margin="10,0,10,0"
				ItemsSource="{Binding DuplicateUser}" SelectedItem="{Binding SelectedItem}" >
					<ListBox.Template>
						<ControlTemplate>
							<ItemsPresenter />
						</ControlTemplate>
					</ListBox.Template>
					<ListBox.ItemTemplate>
						<DataTemplate >
							<Viewbox Height="30"
					HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,15,0,0">
								<RadioButton  Content="{Binding Path=EmployeeSelectionGeneralInfo}" GroupName="Properties" >
									<RadioButton.IsChecked>
										<Binding Path="IsChecked" Mode="TwoWay" />
									</RadioButton.IsChecked>
								</RadioButton>
							</Viewbox>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<Grid Margin="0,20,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Button Command="{Binding Path=SaveDialogCommand}"
		CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
		Style="{StaticResource TileButton}" Background="#64B4D5" Content="{x:Static resx:WinFormMainResource.Confirmation}" Foreground="White" Margin="0,0,10,0"
		Height="45" HorizontalAlignment="Right" Name="button1" VerticalAlignment="Center" Width="125" FontSize="20"/>
					<Button Command="{Binding Path=CancelDialogCommand}" Grid.Column="1"
		CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"  
		Style="{StaticResource TileButton}" Content="{x:Static resx:WinFormMainResource.ReturnOrderScreen}" Height="45" Background="#ef4339" Margin="10,0,0,0"
		HorizontalAlignment="Left" Name="button2" VerticalAlignment="Center" Width="125" Foreground="#fff" FontSize="20"/>
				</Grid>
			</StackPanel>
		</Grid>
	</Border>

</Window>
