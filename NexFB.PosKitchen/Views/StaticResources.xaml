	<Style x:Key="buttonKeypad" TargetType="Button">
		<Setter Property="FontSize" Value="{Binding DataContext.KeypadFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
		<Setter Property="Background" Value="#e2e2e2"/>
