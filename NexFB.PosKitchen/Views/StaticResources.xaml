<ResourceDictionary 
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
	xmlns:col="clr-namespace:System.Collections;assembly=mscorlib" 
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="clr-namespace:NexFB.PosKitchen.ViewModels"
	xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
	xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
	xmlns:views="clr-namespace:NexFB.PosKitchen.Views.ManageOrder">

	<!--Switch view according to Data Type-->
	<DataTemplate DataType="{x:Type vm:WaitingMealViewModel}">
		<views:WaitingMeal />
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding ElementName=myStyle}">

			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate DataType="{x:Type vm:DeliveredFoodViewModel}">
		<views:DeliveredFood />
	</DataTemplate>

	<DataTemplate DataType="{x:Type vm:OrderFoodViewModel}">
		<views:OrderFood />
	</DataTemplate>

	<DataTemplate DataType="{x:Type vm:AwaitingDeliverViewModel}">
		<views:AwaitingDeliver />
	</DataTemplate>

	<!--Selected Item in Listbox-->
	<Style x:Key="CustomLBStyle" TargetType="{x:Type ListBox}">
		<Style.Resources>
			<SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
			<SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
		</Style.Resources>
	</Style>

	<!--Common Style-->
	<!--Default NexFB WinApp Style-->
	<Style TargetType="{x:Type Control}" x:Key="BaseStyle">
		<Setter Property="FontSize" Value="16" />
	</Style>
	<Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}" />
	<Style TargetType="{x:Type Label}" BasedOn="{StaticResource BaseStyle}" />

	<!--Style for display Room Name-->
	<Style x:Key="RoomNumberStyle" TargetType="Border">
		<Setter Property="CornerRadius" Value="5" />
		<Setter Property="Background" Value="#0ac0e8" />
		<Setter Property="MinWidth" Value="50" />
		<Setter Property="Height" Value="28" />
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>

	<!--Style for display when has order note in order request-->
	<Style TargetType="{x:Type Image}" x:Key="HasOrderNote">
		<Style.Triggers>
			<DataTrigger Binding="{Binding Path=HasNote}" Value="True">
				<Setter Property="Source" Value="pack://application:,,,/Images/alert.png"/>
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<!--Tile Button-->
	<!--Style for tile button-->
	<Style x:Key="TileButton" TargetType="Button">
		<Setter Property="FontSize" Value="18" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Name="border" CornerRadius="0" Background="{TemplateBinding Background}" BorderThickness="1">
						<ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center">
						</ContentPresenter>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="Button.IsDefaulted" Value="True">
							<Setter Property="BorderBrush" TargetName="border" Value="Red"/>
						</Trigger>
						<!--<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" TargetName="border" Value="#FFBEE6FD"/>
							<Setter Property="BorderBrush" TargetName="border" Value="#FF3C7FB1"/>
						</Trigger>-->
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Background" TargetName="border" Value="#FFC4E5F6"/>
							<Setter Property="BorderBrush" TargetName="border" Value="#FF2C628B"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Background" TargetName="border" Value="#FFF4F4F4"/>
							<Setter Property="BorderBrush" TargetName="border" Value="#FFADB2B5"/>
							<Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="#FF838383"/>
						</Trigger>
						<DataTrigger Binding="{Binding Path=CurrentStatusId}" Value="1">
							<!--<Setter Property="Content" Value="{x:Static resx:WinFormMainResource.Receive}"></Setter>-->
							<Setter Property="Background" Value="#66b5d7"/>
							<Setter Property="Command" Value="{Binding DataContext.ReceiveOrderFoodCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
							<!--<Setter Property="Command" Value="{Binding Path=DataContext.ReceiveOrderFoodCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}}"/>-->
							<Setter Property="CommandParameter" Value="{Binding Path=OrderId}"/>
						</DataTrigger>

						<DataTrigger Binding="{Binding Path=CurrentStatusId}" Value="2">
							<!--<Setter Property="Content" Value="{x:Static resx:WinFormMainResource.Export}"></Setter>-->
							<Setter Property="Background" Value="#FA5934"/>
							<Setter Property="Command" Value="{Binding DataContext.DeliverOrderFoodCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
							<Setter Property="CommandParameter" Value="{Binding Path=OrderId}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding Path=CurrentStatusId}" Value="3">
							<!--<Setter Property="Content" Value="{x:Static resx:WinFormMainResource.Export}"></Setter>-->
							<Setter Property="Background" Value="#FA5934"/>
							<Setter Property="Command" Value="{Binding DataContext.DeliverOrderFoodCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
							<Setter Property="CommandParameter" Value="{Binding Path=OrderId}"/>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--Tile Button-->
	<!--Style for tile button-->
	<Style x:Key="OrderTileButton" TargetType="Button">
		<Setter Property="FontSize" Value="18" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Name="border" CornerRadius="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2">
						<ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center">
						</ContentPresenter>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="BorderBrush" TargetName="border" Value="#FF0000"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Background" TargetName="border" Value="#F0F0F0"/>
							<Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="#FF838383"/>
						</Trigger>

					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="MenuTile" TargetType="Button">
		<Setter Property="FontSize" Value="23" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Name="border" CornerRadius="0" Background="{TemplateBinding Background}"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2">
						<ContentPresenter x:Name="contentPresenter">
						</ContentPresenter>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="BorderBrush" TargetName="border" Value="#FF0000"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Background" TargetName="border" Value="#FFF4F4F4"/>
							<Setter Property="BorderBrush" TargetName="border" Value="#FFADB2B5"/>
							<Setter Property="BorderThickness" TargetName="border" Value="2"/>
							<Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="#FF838383"/>
						</Trigger>

						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding Path=IsSelectedMealMenu}" Value="True"/>
								<Condition Binding="{Binding Path=IsMainMenu}" Value="True"/>
							</MultiDataTrigger.Conditions>
							<Setter Property="Background" Value="#1271b0"/>
						</MultiDataTrigger>

						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding Path=IsSelectedMealMenu}" Value="True"/>
								<Condition Binding="{Binding Path=IsMainMenu}" Value="False"/>
							</MultiDataTrigger.Conditions>
							<Setter Property="Background" Value="#1271b0"/>
						</MultiDataTrigger>

						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding Path=IsSelectedMealMenu}" Value="False"/>
								<Condition Binding="{Binding Path=IsMainMenu}" Value="True"/>
							</MultiDataTrigger.Conditions>
							<Setter Property="Background" Value="#f26c4f"/>
						</MultiDataTrigger>

						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding Path=IsSelectedMealMenu}" Value="False"/>
								<Condition Binding="{Binding Path=IsMainMenu}" Value="False"/>
							</MultiDataTrigger.Conditions>
							<Setter Property="Background" Value="#46a3e1"/>
						</MultiDataTrigger>

						<DataTrigger Binding="{Binding Path=IsFocusedMealMenu}" Value="True">
							<Setter Property="BorderBrush" Value="#FF0000"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding Path=IsFocusedMealMenu}" Value="False">
							<Setter Property="BorderBrush" Value="#fff"/>
						</DataTrigger>

						<!--<DataTrigger Binding="{Binding Path=IsSelectedMealMenu}" Value="True">
							<Setter Property="Background" Value="#001CD1"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding Path=IsSelectedMealMenu}" Value="False">
							<Setter Property="Background" Value="#46A3E1"/>
						</DataTrigger>-->
						<!--<Trigger Property="IsPressed" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard Storyboard.TargetProperty="Background.Color">
										<ColorAnimation To="Red" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
						</Trigger>-->

					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="EmployeeInGroupTile" TargetType="Button">
		<Setter Property="FontSize" Value="23" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Name="border" CornerRadius="0" Background="{TemplateBinding Background}"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
						<ContentPresenter x:Name="contentPresenter">
						</ContentPresenter>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="BorderBrush" TargetName="border" Value="#FF0000"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Background" TargetName="border" Value="#FFF4F4F4"/>
							<Setter Property="BorderBrush" TargetName="border" Value="#FFADB2B5"/>
							<Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="#FF838383"/>
						</Trigger>
