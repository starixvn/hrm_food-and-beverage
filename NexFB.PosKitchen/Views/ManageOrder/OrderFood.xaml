
<UserControl x:Class="NexFB.PosKitchen.Views.ManageOrder.OrderFood"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d" 
	xmlns:converter="clr-namespace:NexFB.PosKitchen.Converter"
	xmlns:local="clr-namespace:NexFB.PosKitchen.DependencyProperties"
	xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
	d:DesignHeight ="768" d:DesignWidth="1280">
	<!--d:DesignHeight="{Binding DataContext.ScreenHeight, RelativeSource={RelativeSource AncestorType=Window}}" 
	d:DesignWidth="{Binding DataContext.ScreenWidth, RelativeSource={RelativeSource AncestorType=Window}}"-->
	<UserControl.Resources>
		<converter:RangeToBooleanConverter x:Key="conv"/>
		<converter:StringFormatConverter x:Key="stringConverter" />
	</UserControl.Resources>

	<Grid>
		<Grid Mouse.PreviewMouseDown="Grid_PreviewMouseDown" Margin="0,3,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="{Binding Path=LeftSide}"/>
				<ColumnDefinition Width="{Binding Path=MiddleSide}"/>
				<ColumnDefinition Width="{Binding Path=RightSide}"/>
			</Grid.ColumnDefinitions>

			<!--Grid Left-->
			<Grid Width="{Binding Path=LeftSide}" Height="{Binding DataContext.ScreenHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="4,5,0,0" Background="#fff" Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="{Binding Path=LeftSideGeneralInfo}"/>
					<RowDefinition Height="{Binding Path=LeftSideActionButton}"/>
					<RowDefinition Height="{Binding Path=LeftSideKeyPad}"/>
				</Grid.RowDefinitions>
				<!--General Info-->
				<Grid Grid.Row="0" Height="{Binding Path=LeftSideGeneralInfo}">
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Background="#000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="{Binding Path=LeftSide}">
						<Label  FontSize="{Binding Path=GeneralInfoFontSize}" Content="{Binding Path=OrderNo}" HorizontalAlignment="Left" Foreground="#fff"
				            Margin="8,0,0,0" Name="label3" VerticalAlignment="Center" />
						<Label Content="{Binding Path=ReferenceCode}"  FontSize="{Binding Path=GeneralInfoFontSize}" Foreground="#fff" ContentStringFormat="Ref: {0} "
				            HorizontalAlignment="Right" Margin="0,0,10,0" Name="label4" VerticalAlignment="Center" />
					</Grid>
					<!--Display Employee Info-->
					<Grid Grid.RowSpan="4" Grid.Row="1" Width="{Binding Path=LeftSide}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="{Binding Path=LeftSideImageWidth}"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid Grid.Column="0" Width="{Binding Path=LeftSideImageWidth}"
                              HorizontalAlignment="Left" Background="#e2e2e2" Margin="0" Name="grid6" VerticalAlignment="Top">
							<Image Source="{Binding Path=OwnerImage}" Margin="0"
                                   HorizontalAlignment="Left" Name="image1" Stretch="Fill" VerticalAlignment="Top" />
						</Grid>
						<Grid Grid.Column="1" Width="{Binding Path=LeftSideInfoDetails}" Background="#e2e2e2">
							<Grid.RowDefinitions>
								<RowDefinition Height="*"/>
								<RowDefinition Height="*"/>
								<RowDefinition Height="*"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>
							<!--Full Name-->
							<Label Content="{Binding Path=EmployeeInfo.FullNameUpper}" FontWeight="Bold" Foreground="#4091BD" 
                                   FontSize="{Binding Path=GeneralInfoFontSize}" HorizontalAlignment="Left"
                                   VerticalAlignment="Center"  />
							<!--Nick name-->
							<Label Content="{Binding Path=EmployeeInfo.NickName}" Grid.Row="1"
                                   FontSize="{Binding Path=GeneralInfoFontSize}" FontWeight="Bold"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
							<!--Employee code-->
							<Label Grid.Row="2" Content="{Binding Path=EmployeeInfo.Code}" ContentStringFormat="#{0} "
				                   FontSize="{Binding Path=GeneralInfoFontSize}" FontWeight="Bold" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
							<!--Expat Or Local-->
							<Border Background="#fff" HorizontalAlignment="Stretch" Margin="0,2,3,0"
                                    VerticalAlignment="Stretch" Grid.Row="3" Width="{Binding Path=LeftSideInfoDetails}">
								<TextBlock Margin="5,0,0,0" FontSize="{Binding Path=GeneralInfoFontSize}" FontWeight="Bold"
					            Text="{Binding Path=EmployeeInfo.DeparmentNameDetails}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
							</Border>

						</Grid>
					</Grid>

					<Grid Grid.Row="6" Background="#e2e2e2" Width="{Binding Path=LeftSide}">
						<Border Background="#fff" BorderThickness="1" Width="{Binding Path=LeftSide}" 
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1,1,6,0">
							<TextBlock FontSize="{Binding Path=GeneralInfoFontSize}" Text="{Binding Path=LocationName}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
						</Border>
					</Grid>

				</Grid>

				<!--Button Action-->
				<Grid Grid.Row="1" Width="{Binding Path=LeftSide}" Height="{Binding Path=LeftSideActionButton}"
                      Background="#fff" HorizontalAlignment="Left" Name="GridActionButton" VerticalAlignment="Top">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<!--Pick Room-->
					<Button Command="{Binding Path=PickRoomCommand}" Style="{StaticResource OrderTileButton}"
                            Content="{x:Static resx:WinFormMainResource.PickRoom}" HorizontalAlignment="Stretch" 
                            FontSize="{Binding Path=GeneralInfoFontSize}" Margin="0,3,0,0" VerticalAlignment="Stretch"
                            Background="{Binding Path=BackgroundButtonPickRoom}" 
                            Foreground="#fff" BorderBrush="{Binding Path=BorderButtonPickRoom}" />
					<!--Main Food-->
					<Button Command="{Binding Path=ChooseMainFoodCommand}" FontSize="{Binding Path=GeneralInfoFontSize}" 
                            Style="{StaticResource OrderTileButton}" Content="{x:Static resx:WinFormMainResource.ChooseDishes}" 
                            HorizontalAlignment="Stretch" Margin="1,3,4,0" VerticalAlignment="Stretch"
                            Background="{Binding Path=BackgroundButtonMainFood}" Foreground="#fff" BorderBrush="{Binding Path=BorderButtonMainFood}" Grid.Column="1" />
					<!--Pick Group-->
					<Button Command="{Binding Path=PickGroupCommand}" FontSize="{Binding Path=GeneralInfoFontSize}" Style="{StaticResource OrderTileButton}" 
                            Content="{x:Static resx:WinFormMainResource.PickGroup}" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                            Background="{Binding Path=BackgroundButtonPickGroup}" Foreground="#fff" BorderBrush="{Binding Path=BorderButtonPickGroup}" 
                            Margin="0,0,0,3"/>
					<!--Alternative Food Command-->
					<Button Command="{Binding Path=ChooseAlternativeFoodCommand}" FontSize="{Binding Path=GeneralInfoFontSize}"
                            BorderBrush="{Binding Path=BorderButtonAlternativeFood}" Content="{x:Static resx:WinFormMainResource.AlternativeFood}" 
                            Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" Margin="1,0,4,3" Foreground="#fff" VerticalAlignment="Stretch"
                            Background="{Binding Path=BackgroundButtonAlternativeFood}" Style="{StaticResource OrderTileButton}" />

				</Grid>

				<!--KeyPad-->
				<Grid Width="{Binding Path=LeftSide}" HorizontalAlignment="Left" Background="#F0F0F0" Grid.Row="2">
					<Grid.RowDefinitions>
						<RowDefinition Height="{Binding Path=KeyPadHeader}"/>
						<RowDefinition Height="{Binding Path=KeyPadResult}"/>
						<RowDefinition Height="{Binding Path=KeyPadMainButton}"/>
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
						<Label Content="{x:Static resx:WinFormMainResource.KeypadInfo}" 
                           FontSize="{Binding Path=GeneralInfoFontSize}"  
                           Margin="8,10,0,0" />
					</Grid>

					<!--TextBlock display Keypad Result-->
					<Grid Grid.Row="1">
						<Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderThickness="2" Margin="2,0,5,0"
                            Mouse.PreviewMouseDown="ResultTextBlock_PreviewMouseDown" x:Name="ResultTextBlock">
							<Label Content="{Binding Result}" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" 
                                FontSize="{Binding Path=KeyPadResultFontSize}" Background="#fff"/>
						</Border>
					</Grid>
					<!--Keypad button-->
					<Grid Grid.Row="2" Height="{Binding Path=KeyPadMainButton}" Width="{Binding Path=LeftSide}">
						<Grid Name="gridKeyPad" Margin="3,3,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition />
								<ColumnDefinition />
								<ColumnDefinition />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<!--Row 0-->
							<Grid Grid.Row="0">
								<Button   Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD1" Content="1" Margin="0,4,-5,4" />
							</Grid>

							<Grid Grid.Column="1" Grid.Row="0">
								<Button  Style="{StaticResource buttonKeypad}"
				 Command="{Binding NumPadPressed}" CommandParameter="NUMPAD2" Content="2" Margin="12,4,-17,4" />
							</Grid>

							<Grid Grid.Column="2" Grid.Row="0">
								<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD3" Content="3" Margin="24,4,-27,4" />
							</Grid>

							<Grid Grid.Column="3" Grid.Row="0" Grid.ColumnSpan="2">
								<Button x:Name="button8" Command="{Binding NumPadReleased}" Margin="33,4,7,4" Style="{StaticResource buttonKeypad}">
									<!--<Path Stretch="Fill" Width="33" Height="21" Data="F1M555.0371,274.4893L552.7871,276.7383L549.9861,273.9373L547.1991,276.7243L545.1131,274.6393L547.9001,271.8523L545.0101,268.9603L547.2601,266.7113L550.1501,269.6023L552.8921,266.8613L554.9761,268.9463L552.2361,271.6883z M555.3751,264.0003L544.8751,264.0003C543.1251,264.1253,535.0001,270.7503,535.0001,272.2503C535.0001,273.7503,543.1251,279.3753,544.8751,279.5003L555.3751,279.5003C558.8751,279.5003,559.3751,277.7093,559.3751,275.5003L559.3751,268.0003C559.3751,265.7913,558.7501,264.0003,555.3751,264.0003" Fill="#FF333333" />-->
									<Image Source="pack://application:,,,/Images/multi.png" Height="40" Width="42" />
									<!--<Image Source="pack://application:,,,/Images/button_cancel.png" Height="40" Width="42" />-->
								</Button>
							</Grid>

							<!--Row 1-->

							<Grid Grid.Row="1">
								<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD4" Content="4" Margin="0,7,-5,1" />
							</Grid>

							<Grid Grid.Column="1" Grid.Row="1">
								<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD5" Content="5" Margin="12,7,-17,1" />
							</Grid>

							<Grid Grid.Column="2" Grid.Row="1">
								<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD6" Content="6" Margin="24,7,-27,1" />
							</Grid>

							<Grid Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" >
								<Button FontWeight="Black"  FontSize="31" Style="{StaticResource buttonKeypad}" 
				 Command="{Binding Path=ReceiveCommand}" Content="{x:Static resx:WinFormMainResource.ReceiveUpper}" Margin="33,7,7,1" />
								<Button FontWeight="Black" FontSize="31" Style="{StaticResource buttonKeypad}" Visibility="{Binding Path=SaveButtonVisible}"
				 Command="{Binding Path=ReceiveCommand}" Content="{x:Static resx:WinFormMainResource.ReceiveUpper1}" Margin="33,7,7,1" />
							</Grid>

							<!--Row 2-->

							<Grid Grid.Row="2">
								<Button Style="{StaticResource buttonKeypad}" Content="7"
				 BorderThickness="1" Command="{Binding Path=NumPadPressed}" CommandParameter="NUMPAD7" Margin="0,10,-5,-2" ></Button>
							</Grid>

							<Grid Grid.Column="1" Grid.Row="2">
								<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD8" BorderThickness="1" Content="8" Margin="12,10,-17,-2" />
							</Grid>

							<Grid Grid.Column="2" Grid.Row="2">
								<Button Style="{StaticResource buttonKeypad}"
				Command="{Binding NumPadPressed}" CommandParameter="NUMPAD9" Content="9" Margin="24,10,-28,-2" Grid.RowSpan="2" />
							</Grid>

							<Grid Grid.Column="3" Grid.Row="2" Grid.ColumnSpan="2">
								<Button FontWeight="Black" x:Name="button19"  FontSize="31" Style="{StaticResource buttonKeypad}"
                                    Command="{Binding Path=AddCommand}" CommandParameter="NUMPADM" Content="{x:Static resx:WinFormMainResource.Add}" Margin="33,10,7,-2" />
							</Grid>

							<!--Row 3-->
							<Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
								<Button Style="{StaticResource buttonKeypad}" x:Name="button17" 
								Command="{Binding NumPadPressed}" CommandParameter="NUMPAD0" Content="0" Margin="12,14,-28,-6" />
							</Grid>

							<Grid Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2">
								<Button FontWeight="Black" x:Name="buttonKeyH"  FontSize="31" Style="{StaticResource buttonKeypad}" 
                                    Command="{Binding Path=CancelCommand}" CommandParameter="{Binding ElementName=ResultTextBlock}" 
                                    Content="{x:Static resx:WinFormMainResource.Cancel}" Margin="33,14,7,-6" />
							</Grid>

							<Grid Grid.Row="3">
								<Button Style="{StaticResource buttonKeypad}" Name="buttonNumPad"
									BorderThickness="1" Command="{Binding Path=ChangeKeyPad}" CommandParameter="NUMPAD7" Margin="0,14,-5,-6">
									<Grid>
										<!--<Image Visibility="{Binding NumPadVisible}"
									Source="pack://application:,,,/Images/arrow-icon.png" Height="51" Width="27" />-->
										<Label Content="ABC"  HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black"
									 FontSize="{Binding DataContext.KeypadFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
									</Grid>

								</Button>
							</Grid>

						</Grid>
					</Grid>




				</Grid>

			</Grid>

			<!--Grid Center-->
			<Grid Background="#fff" Width="{Binding Path=MiddleSide}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="1" Margin="2,0,0,0">

				<ListBox Name="ListMenuItem" BorderBrush="#FFF" BorderThickness="0"  Width="{Binding Path=MiddleSide}"
                         ItemsSource="{Binding Path=CommonKitchenOrder}" Style="{StaticResource CustomLBStyle}"  Margin="0">
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Padding" Value="0"/>
						</Style>
					</ListBox.ItemContainerStyle>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Button Style="{StaticResource MenuTile}" Margin="2,0,0,2" MinHeight="60"
                                    Width="{Binding DataContext.MiddleSideWrapper, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    Command="{Binding DataContext.DefaulMenuSelected, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                    CommandParameter="{Binding Path=ItemId}">
								<Grid Width="{Binding DataContext.MiddleSide, RelativeSource={RelativeSource AncestorType=ListBox}}">
									<TextBlock Foreground="#FFF" 
                                               FontSize="{Binding DataContext.GeneralInfoFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                               HorizontalAlignment="Left" Margin="10,0,35,0" VerticalAlignment="Center" 
                                               Text="{Binding Path=ItemName}" TextWrapping="WrapWithOverflow"></TextBlock>
									<Label HorizontalAlignment="Right" Margin="0,0,50,0" VerticalAlignment="Center" Foreground="Yellow"
                                           FontSize="{Binding DataContext.GeneralInfoFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}" >
										<Label.Style>
											<Style TargetType="Label">
												<Style.Triggers>
													<DataTrigger Binding="{Binding Path=Quantity, Converter={StaticResource conv}}" Value="True">
														<Setter Property="Content" Value=""/>
													</DataTrigger>
													<DataTrigger Binding="{Binding Path=Quantity, Converter={StaticResource conv}}" Value="False">
														<Setter Property="Content" Value="{Binding Path=Quantity}"/>
														<Setter Property="ContentStringFormat" Value="x {0} "/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Label.Style>
									</Label>
								</Grid>

							</Button>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>

			<!--Grid Right-->
			<Grid Visibility="{Binding GridUserVisibility}" Background="#FFFFFF" Width="{Binding Path=RightSide}" 
                  VerticalAlignment="Top" Grid.Column="2" Margin="3,3,-2,0">

				<Grid Height="60" HorizontalAlignment="Left" VerticalAlignment="Top" Width="{Binding Path=RightSide}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Button Style="{StaticResource MenuTile}" Command="{Binding Path=SelectAllUserInGroup}" Background="#6CB23F" Foreground="#fff" Margin="2,0,2,0"
                            FontSize="{Binding Path=GeneralInfoFontSize}" HorizontalAlignment="Stretch" Name="button4" VerticalAlignment="Stretch">
						<Label Foreground="#fff" HorizontalAlignment="Center" Margin="10,0,0,0" FontSize="{Binding Path=GeneralInfoFontSize}"
                                VerticalAlignment="Center" Content="{x:Static resx:WinFormMainResource.SelectAll}"></Label>
					</Button>
					<Button Style="{StaticResource MenuTile}" Grid.Column="1" Background="#B7B7B7" Foreground="White"
						HorizontalAlignment="Stretch" Name="button12" VerticalAlignment="Stretch" Margin="0,0,2,0">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
							<Label Content="{x:Static resx:WinFormMainResource.Quantity}"  VerticalAlignment="Center" FontSize="{Binding Path=GeneralInfoFontSize}" />
							<Label Content="{Binding Path=UserInGroup.Count}" Margin="-7,1,0,0" Foreground="#BD2828" FontSize="{Binding Path=GeneralInfoFontSize}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Black" />
						</StackPanel>
					</Button>
				</Grid>

				<!--Employee In Group Order-->
				<Grid Background="#E2E2E2" Width="{Binding Path=RightSide}" Margin="0,65,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
					<ListBox ItemsSource="{Binding Path=UserInGroup}" Name="employeeOrder" Style="{StaticResource CustomLBStyle}" 
                             Margin="1,2,2,1" BorderThickness="1" Width="{Binding Path=RightSide}" BorderBrush="Silver">
						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem">
								<Setter Property="Padding" Value="0"/>
							</Style>
						</ListBox.ItemContainerStyle>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Button Command="{Binding DataContext.DefaultEmployeeSelected, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                        CommandParameter="{Binding Path=SysId}" Style="{StaticResource EmployeeInGroupTile}" 
                                        Background="#fff" Padding="0" HorizontalAlignment="Stretch"
                                        Width="{Binding DataContext.RightSideWrapper, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        Name="button16" VerticalAlignment="Stretch"  Margin="0,1,5,1">
									<Grid HorizontalAlignment="Stretch" Name="border1" Background="{Binding Path=EmployeeOrderMealColor}"
                                          VerticalAlignment="Stretch" 
                                          Width="{Binding DataContext.RightSide, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          Height="{Binding DataContext.RightSideImageHeight, RelativeSource={RelativeSource AncestorType=ListBox}}">

										<Image Source="{Binding Path=ImageSource}" Stretch="Fill" HorizontalAlignment="Left"
                                               Width="{Binding DataContext.RightSideImageWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                               Height="{Binding DataContext.RightSideImageHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
										<Grid Height="{Binding DataContext.RightSideImageHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                              Width="{Binding DataContext.RightSideInfoDetails, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              VerticalAlignment="Center" HorizontalAlignment="Right" Background="{Binding Path=EmployeeOrderMealColor}"
                                              Margin="0,0,5,0">
											<Grid Width="{Binding DataContext.RightSideInfoDetails, RelativeSource={RelativeSource AncestorType=ListBox}}">
												<Label Content="{Binding Path=NickNameHasOrdered}" FontSize="18" FontWeight="Black" 
                                                       VerticalAlignment="Top" Margin="2,-5,-2,0" Foreground="#004069" />
												<DockPanel Margin="0,22,4,0" >
													<TextBlock FontSize="14" HorizontalAlignment="Left" Margin="15,3,15,0"
												local:TextBlockInline.FormattedText="{Binding Path=OrderSummary, Mode=OneWay, Converter={StaticResource stringConverter}}" 
												VerticalAlignment="Top" TextWrapping="WrapWithOverflow" Name="orderDetails"/>
												</DockPanel>
											</Grid>
										</Grid>
									</Grid>
								</Button>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</Grid>
		</Grid>
		<Rectangle Visibility="{Binding OverlayVisible}"
		 Height="{Binding DataContext.ScreenHeight, RelativeSource={RelativeSource AncestorType=Window}}" 
		Width="{Binding DataContext.ScreenWidth, RelativeSource={RelativeSource AncestorType=Window}}"
		HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1" Fill="#000" Opacity=".4" Margin="0" />
	</Grid>

</UserControl>

