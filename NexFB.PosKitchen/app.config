		<add name="NexFBLocal" connectionString="packet size=4096; Data Source=CP0081-QUINN\MSSQLSERVER2012;TrustServerCertificate = true;Connect Timeout=60;Asynchronous Processing=true;Initial Catalog=FBM;integrated security=false; user id=sa; password=IOR71CwzkLI=;" providerName="System.Data.SqlClient"/>
