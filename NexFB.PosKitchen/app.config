<?xml version="1.0"?>
<configuration>
	<configSections>
		<section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
		<section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging"/>
	</configSections>
	<Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
		<providers>
			<add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="SpNames.xml" enableWatching="1"/>
		</providers>
	</Fanex.Data.DbSettingProvider>

	<appSettings>
		<add key="DBDelayTime" value="1"/>
		<add key="AutoRefeshTime" value="60"/>

		<!--Using "en-US" to change language to Enlish and "vi-VN" to Vietnamese Language-->
		<add key="DefaultLanguage" value="vi-VN"/>

		<add key="ServerDB" value="NexFB"/>
		<add key="LocalDB" value="NexFBLocal"/>
		<!--<add key="DefaultLanguage" value="en-US" />-->

		<!--The mode of printer for test only, it print .xps file in the desktop
		When using in Production mode, change "DEV"  to "RELEASE" - real printer will work.-->
		<add key="ReleaseMode" value="DEV"/>

		<add key="HubHost" value="http://10.19.10.140:8080/"/>
		<add key="HubHostLocal" value="http://10.19.10.140:7777/"/>
	</appSettings>

	<connectionStrings>
		<add name="NexFB" connectionString="packet size=4096; Data Source=10.19.10.140\SQLEXPRESS;TrustServerCertificate = true;Connect Timeout=10;Asynchronous Processing=true;Initial Catalog=FBM;integrated security=false; user id=internalteam; password=iftJ5aAHCdGe4yc8quUqSw==;" providerName="System.Data.SqlClient"/>
		<add name="NexFBLocal" connectionString="packet size=4096; Data Source=10.19.10.65\MSSQLSERVER2012;TrustServerCertificate = true;Connect Timeout=10;Asynchronous Processing=true;Initial Catalog=FBM;integrated security=false; user id=sa; password=IOR71CwzkLI=;" providerName="System.Data.SqlClient"/>


		<!--<add name="NexFB" connectionString="packet size=4096; Data Source=10.19.10.140\SQLEXPRESS;TrustServerCertificate = true;Connect Timeout=20;Asynchronous Processing=true;Initial Catalog=FBM;integrated security=false; user id=internalteam; password=IOR71CwzkLI=;" providerName="System.Data.SqlClient"/>
		<add name="NexFBLocal" connectionString="packet size=4096; Data Source=10.19.10.65\MSSQLSERVER2012;TrustServerCertificate = true;Connect Timeout=20;Asynchronous Processing=true;Initial Catalog=FBM;integrated security=false; user id=sa; password=iftJ5aAHCdGe4yc8quUqSw==;" providerName="System.Data.SqlClient"/>-->
	</connectionStrings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
	</startup>

	<Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.209\private$\entlib" defaultCategory="FB-Local"/>
	<!--<Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.18.114.21\private$\entlib" defaultCategory="FnB-Live" />-->

	<!--<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30AD4FE6B2A6AEED" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0"/>
			</dependentAssembly>
		</assemblyBinding>
	</runtime>-->

</configuration>
