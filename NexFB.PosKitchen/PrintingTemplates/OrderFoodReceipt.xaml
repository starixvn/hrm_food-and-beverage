
<FixedDocument xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			   xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
               xml:lang="en-GB">
	<PageContent>
		<FixedPage Width="693.76" Height="1123" Margin="0,20,0,0" Name="GeneralInfo">
			<Grid>
				<Rectangle Fill="{Binding Path=TicketBackground}" Stroke="#FF000000" StrokeThickness="1" StrokeDashArray="{Binding Path=TicketStrokeDash}" SnapsToDevicePixels="True"
				Height="96" HorizontalAlignment="Left" Margin="23,6,0,0" VerticalAlignment="Top" Width="140" />
				<Border BorderBrush="Transparent" BorderThickness="0" Height="96" HorizontalAlignment="Left" Margin="23,6,0,0" VerticalAlignment="Top" Width="140">
					<TextBlock Foreground="{Binding Path=TicketForeground}" FontSize="75" Text="{Binding Path=OrderNo}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
				</Border>
				<TextBlock Height="25" HorizontalAlignment="Left" Margin="165,50,0,0" VerticalAlignment="Top">
				......................................................................................................................................................................................
				</TextBlock>
				<TextBlock FontSize="20" Height="31" HorizontalAlignment="Left" Margin="177,32,0,0" Text="{Binding Path=NickName}" VerticalAlignment="Top" />
				<TextBlock FontWeight="Black" FontSize="20" Height="31" HorizontalAlignment="Left" Margin="251,62,0,0" 
			Text="{Binding Path=FloorName}" VerticalAlignment="Top" />
				<TextBlock Height="23" HorizontalAlignment="Left" Margin="177,70,0,0" Text="{x:Static resx:WinFormMainResource.FloorBilingual}" VerticalAlignment="Top" Width="76" />
				<Border BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" Margin="23,103,0,984" Width="670">
					<TextBlock FontSize="16" Text="{Binding Path=VnmName}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
				</Border>



				<Grid Height="36" HorizontalAlignment="Center"  VerticalAlignment="Top" Width="649" Margin="23,127,0,0">
					<DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Label FontSize="16" Content="{Binding Path=PrintLabel}" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center"/>
						<Label FontSize="16" Content="{Binding Path=CurrentDateString}" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center" />
					</DockPanel>

				</Grid>

				<Border BorderBrush="Black" BorderThickness="0,1,0,1" Height="33" HorizontalAlignment="Left" Margin="23,171,0,0" VerticalAlignment="Top" Width="660">
					<Grid Height="29" Width="660">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="180"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="170"/>
						</Grid.ColumnDefinitions>
						<TextBlock FontSize="13" Height="23" HorizontalAlignment="Left" Margin="6,6,0,0" Text="{x:Static resx:WinFormMainResource.NameBilingual}" VerticalAlignment="Top" />
						<TextBlock FontSize="13" Grid.Column="1" Margin="0,6,20,0" Height="23" HorizontalAlignment="Right" Text="{x:Static resx:WinFormMainResource.SetMenu}" VerticalAlignment="Top" />
						<TextBlock Grid.Column="2" Height="23" HorizontalAlignment="Right" Margin="0,6,10,0" VerticalAlignment="Top" Text="{x:Static resx:WinFormMainResource.Amount}" />
					</Grid>
				</Border>
			</Grid>
			<StackPanel HorizontalAlignment="Left" Margin="23,207,0,0" VerticalAlignment="Top" Width="660">
				<ListBox BorderThickness="0" ItemsSource="{Binding Path=ListMenu}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="660" >
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="180"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="170"/>
								</Grid.ColumnDefinitions>
								<Label FontSize="12" ContentStringFormat="> {0} " Content="{Binding Path=DisplayName}" Height="28" HorizontalAlignment="Left" Margin="0,6,0,0" VerticalAlignment="Top" />
								<TextBlock FontSize="12" TextWrapping="WrapWithOverflow"
								 Text="{Binding Path=SetMenuAndQuantity}" Grid.Column="1" Height="28" HorizontalAlignment="Right" Margin="0,6,25,0" VerticalAlignment="Top" />
								<Label FontSize="12" Content="{Binding Path=DisplayPrice}" Grid.Column="2" Height="28" HorizontalAlignment="Right" Margin="0,6,10,0" VerticalAlignment="Top" />
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<Border BorderBrush="Black" BorderThickness="0,0,0,1" Height="1" Width="660" />
				<Grid Height="39" Width="660">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="180"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="170"/>
					</Grid.ColumnDefinitions>
					<TextBlock FontSize="16" Height="34" HorizontalAlignment="Left" Margin="3,5,0,0" Text="{x:Static resx:WinFormMainResource.TotalBilingual}" VerticalAlignment="Top" />
					<TextBlock FontSize="16" Text="{Binding ElementName=GeneralInfo, Path=DataContext.TotalOrder}"
				 FontWeight="Bold" Grid.Column="1" Height="28" HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Top" />
					<TextBlock FontSize="16" Text="{Binding ElementName=GeneralInfo, Path=DataContext.TotalAmount}"
				 FontWeight="Bold" Grid.Column="2" Height="28" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Top" />
				</Grid>
				<Grid Height="99" Width="660">
					<Border x:Name="MyBorderedButton" Width="650" BorderThickness="0,1,0,1" Margin="1,0,1,18">
						<Border.BorderBrush>
							<VisualBrush>
								<VisualBrush.Visual>
									<Rectangle StrokeDashArray="4 2"
                      Stroke="Black"
                      StrokeThickness="1"
                      RadiusX="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=CornerRadius.TopRight}"
                      RadiusY="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=CornerRadius.BottomLeft}"
                      Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=ActualWidth}"
                      Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=ActualHeight}"/>
								</VisualBrush.Visual>
							</VisualBrush>
						</Border.BorderBrush>
						<Grid Height="100">
							<TextBlock Height="23" HorizontalAlignment="Left" Margin="25,11,0,0" Text="{x:Static resx:WinFormMainResource.Ref}" VerticalAlignment="Top" />
							<TextBlock Height="23" HorizontalAlignment="Left" Margin="54,11,0,0" Text="{Binding ElementName=GeneralInfo, Path=DataContext.OrderId}" VerticalAlignment="Top" />
							<TextBlock Height="23" HorizontalAlignment="Left" Margin="25,40,0,0" Text="{x:Static resx:WinFormMainResource.RemarkBilingual}" VerticalAlignment="Top" />
							<TextBlock Height="23" HorizontalAlignment="Left" Margin="128,40,0,0" Text="{Binding ElementName=GeneralInfo, Path=DataContext.Remark}" VerticalAlignment="Top" />
							<Grid Visibility="{Binding ElementName=GeneralInfo, Path=DataContext.HasEdited}">
								<Rectangle Height="36" Fill="Black" HorizontalAlignment="Left" Margin="468,3,0,0" Stroke="Black" VerticalAlignment="Top" Width="171" />
								<TextBlock FontWeight="Black" FontSize="20" Foreground="White" Height="31" HorizontalAlignment="Left" Margin="476,6,0,0" Text="{x:Static resx:WinFormMainResource.ReduceBilingual}" VerticalAlignment="Top" />
							</Grid>
						</Grid>
					</Border>
				</Grid>
			</StackPanel>
		</FixedPage>
	</PageContent>
</FixedDocument>
