<FixedDocument xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			   xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
               xml:lang="en-GB">
	<PageContent Width="271.25" Height="auto">
		<FixedPage VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
			<Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,20,0,0" Name="GeneralInfo">

<!--<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			   xmlns:resx="clr-namespace:NexFB.Resources;assembly=NexFB.Resources"
               xml:lang="en-GB">
	<Grid Width="271.25" Height="1123.2">
		<Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
			<Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,20,0,0" Name="GeneralInfo">-->
				<Grid.RowDefinitions>
					<RowDefinition Height="50"/>
					<RowDefinition Height="35"/>
					<RowDefinition Height="40"/>
					<RowDefinition Height="34"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!--Row 0 - Order Number-->
				<Grid Grid.Row="0" VerticalAlignment="Stretch">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="80"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<!--Column 0-->
					<Rectangle Grid.Column="0" Fill="{Binding Path=TicketBackground}" Stroke="#FF000000" StrokeThickness="1" 
						StrokeDashArray="{Binding Path=TicketStrokeDash}" SnapsToDevicePixels="True"
						Height="43" Margin="5,4,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" />
					<Border Grid.Column="0" BorderBrush="Transparent" BorderThickness="0" Height="43" HorizontalAlignment="Stretch"
						 Margin="5,4,0,0" VerticalAlignment="Top">
						<TextBlock Foreground="{Binding Path=TicketForeground}" FontSize="40" Text="{Binding Path=OrderNo}"
						VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Black"/>
					</Border>

					<!--Column 1-->
					<TextBlock Grid.Column="1" FontSize="17" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" 
						Text="{Binding Path=InvoiceNickName}" Margin="7,3,0,0"/>

					<TextBlock Grid.Column="1" Height="25" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,10,0,5">
						.......................................................................
					</TextBlock>

					<Grid Visibility="{Binding Path=PhoneHeaderVisible}"
					 Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="21" Margin="7,0,0,3">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="{x:Static resx:WinFormMainResource.Phone}" FontSize="17"/>
							<TextBlock Text="{Binding Path=Phone}" FontSize="17" Margin="5,0,0,0"/>
						</StackPanel>
					</Grid>

					<!--<TextBlock Grid.Column="1" FontSize="17" Height="21" HorizontalAlignment="Left" VerticalAlignment="Bottom" 
						Text="0967703079" Margin="7,0,0,7"/>-->

				</Grid>

				<!--Row 1-->
				<Grid Grid.Row="1">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,1"
						Text="{x:Static resx:WinFormMainResource.FloorBilingual}" VerticalAlignment="Bottom" FontSize="25"/>

						<TextBlock Grid.Column="1" FontWeight="Black" FontSize="40" 
						HorizontalAlignment="Left" Margin="5,0,0,-6" Text="{Binding Path=FloorName}" VerticalAlignment="Bottom" />
					</StackPanel>
				</Grid>

				<!--Row 2-->
				<Grid Grid.Row="2">
					<Grid.RowDefinitions>
						<RowDefinition/>
						<RowDefinition />
					</Grid.RowDefinitions>
					<Border BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Margin="-10,0,0,0">
						<TextBlock FontSize="14" Text="{Binding Path=VnmName}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
					</Border>

					<Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,0">
						<DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
							<Label FontSize="14" Content="{Binding Path=PrintLabel}" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center"/>
							<Label FontSize="14" Content="{Binding Path=CurrentDateString}" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center" />
						</DockPanel>
					</Grid>
				</Grid>

				<!--Row 3-->
				<Border BorderBrush="Black" BorderThickness="0,1,0,1" Grid.Row="3"
					 Height="22" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,10,0,0">
					<Grid Height="22" Width="271">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="65"/>
							<ColumnDefinition Width="120"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock FontSize="12" Height="23" HorizontalAlignment="Left" Margin="3,0,0,0"
						Text="{x:Static resx:WinFormMainResource.NameBilingual}" VerticalAlignment="Top" />

						<TextBlock FontSize="12" Grid.Column="1" Height="23" HorizontalAlignment="Center"
						 Text="{x:Static resx:WinFormMainResource.Menu}" VerticalAlignment="Top"  Margin="-12,0,0,0"/>

						<TextBlock FontSize="12" Grid.Column="2" Height="23" HorizontalAlignment="Right" VerticalAlignment="Top" 
						Text="{x:Static resx:WinFormMainResource.Quantity1}" Margin="0,0,3,0"/>
					</Grid>
				</Border>

				<!--Row 4-->
				<StackPanel Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-10,0,10">
					<ListBox BorderThickness="0" ItemsSource="{Binding Path=ListMenu}"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,5">
						<ListBox.Template>
							<ControlTemplate>
								<ItemsPresenter />
							</ControlTemplate>
						</ListBox.Template>

						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="271" Margin="0,10,0,-21">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="100" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="35" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="{Binding Path=DisplayRowHeight}"/>
									</Grid.RowDefinitions>

									<Label FontSize="10" ContentStringFormat="> {0} " Content="{Binding Path=NickName}" 
									HorizontalAlignment="Left" Margin="0,0,0,-15" VerticalAlignment="Stretch" />

									<TextBlock FontSize="10" TextWrapping="WrapWithOverflow" 
									Text="{Binding Path=SetMenuAndQuantity}" Grid.Column="1"
									HorizontalAlignment="Left" Margin="-7,5,0,-15" VerticalAlignment="Stretch" />

									<Label FontSize="10" Content="{Binding Path=DisplayQuantity}" Grid.Column="2"
									 HorizontalAlignment="Right" Margin="0,0,5,-15" VerticalAlignment="Stretch" />
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<Border BorderBrush="Black" BorderThickness="0,1,0,1" Height="4"
					 HorizontalAlignment="Stretch" Margin="0,12,0,0" >
					</Border>
					<Border BorderBrush="Black" BorderThickness="0,1,0,1" Height="4"
					 HorizontalAlignment="Stretch" Margin="0,2,0,0" >
					</Border>

					<ListBox BorderThickness="0" ItemsSource="{Binding Path=MenuCount}"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,5">
						<ListBox.Template>
							<ControlTemplate>
								<ItemsPresenter />
							</ControlTemplate>
						</ListBox.Template>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="271" Margin="0,3,0,-10">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="10" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="40" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="{Binding Path=DisplayRowHeight}"/>
									</Grid.RowDefinitions>

									<TextBlock Grid.Row="0" Text=">" Margin="0,2,0,0"/>

									<TextBlock FontSize="15" Text="{Binding Path=MenuVnmName}" Grid.Column="1"
									TextWrapping="WrapWithOverflow" 
									HorizontalAlignment="Left" Margin="0,1,0,0" VerticalAlignment="Stretch" />

									<TextBlock FontSize="15" 
									Text="{Binding Path=Quantity}" Grid.Column="2"
									HorizontalAlignment="Right" Margin="0,1,7,0" VerticalAlignment="Stretch" />
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<Border BorderBrush="Black" BorderThickness="1" Height="1" HorizontalAlignment="Stretch" Margin="0,5,0,0" />

					<Grid Height="39" HorizontalAlignment="Stretch" Margin="0,5,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="60"/>
						</Grid.ColumnDefinitions>
						<TextBlock FontSize="15" Height="28" HorizontalAlignment="Right" FontWeight="Black"
						 Margin="5,0,0,0" Text="{x:Static resx:WinFormMainResource.TotalBilingual}" VerticalAlignment="Top" />
						<TextBlock FontSize="15" Text="{Binding ElementName=GeneralInfo, Path=DataContext.TotalOrder}" 
				 FontWeight="Bold" Grid.Column="2" Height="28" HorizontalAlignment="Right" Margin="0,0,5,0" VerticalAlignment="Top" />
					</Grid>

					<Grid HorizontalAlignment="Stretch" Margin="0,-15,0,0">
						<Border x:Name="MyBorderedButton" HorizontalAlignment="Stretch" BorderThickness="0,1,0,1" Margin="1,0,1,10">
							<Border.BorderBrush>
								<VisualBrush>
									<VisualBrush.Visual>
										<Rectangle StrokeDashArray="4 2" Stroke="Black" StrokeThickness="1" RadiusX="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=CornerRadius.TopRight}" RadiusY="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=CornerRadius.BottomLeft}" Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=ActualWidth}" Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=ActualHeight}" />
									</VisualBrush.Visual>
								</VisualBrush>
							</Border.BorderBrush>
							<Grid>
								<TextBlock FontSize="12" Height="23" HorizontalAlignment="Left" Margin="10,4,0,0" 
						Text="{x:Static resx:WinFormMainResource.Ref}" VerticalAlignment="Top" />

								<TextBlock FontSize="12" Height="23" HorizontalAlignment="Left" Margin="36,4,0,0" 
						Text="{Binding ElementName=GeneralInfo, Path=DataContext.OrderId}" VerticalAlignment="Top" />

								<TextBlock FontSize="12" Height="23" HorizontalAlignment="Left" Margin="10,26,0,0" 
						Text="{x:Static resx:WinFormMainResource.RemarkBilingual}" VerticalAlignment="Top" />

								<TextBlock FontSize="15" HorizontalAlignment="Left" Margin="10,45,0,0" 
								TextWrapping="WrapWithOverflow" Width="260"
						Text="{Binding ElementName=GeneralInfo, Path=DataContext.DisplayRemak}" VerticalAlignment="Top" FontWeight="Black"/>

								<Grid Visibility="{Binding ElementName=GeneralInfo, Path=DataContext.HasEdited}">
									<Rectangle Height="34" Fill="Black" HorizontalAlignment="Left" Margin="128,3,0,0" Stroke="Black" VerticalAlignment="Top" Width="140" />
									<TextBlock FontWeight="Black" FontSize="15" Foreground="White" 
							Height="31" HorizontalAlignment="Left" Margin="183,10,0,0"
							Text="{x:Static resx:WinFormMainResource.ReduceBilingual}" VerticalAlignment="Top" />
								</Grid>
							</Grid>
						</Border>
					</Grid>
				</StackPanel>

			<!--</Grid>
		</Grid>
	</Grid>
</Window>-->

			</Grid>
		</FixedPage>
	</PageContent>
</FixedDocument>	