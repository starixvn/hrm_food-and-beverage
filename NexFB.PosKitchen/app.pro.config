        <add name="NexFBLocal" connectionString="packet size=4096; Data Source=10.19.10.65\MSSQLSERVER2012;TrustServerCertificate = true;Connect Timeout=10;Asynchronous Processing=true;Initial Catalog=FBM;integrated security=false; user id=sa; password=IOR71CwzkLI=;" providerName="System.Data.SqlClient" />
